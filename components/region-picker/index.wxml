<!-- 地区选择半屏弹层：底部上滑，面包屑下钻 -->
<view class="rp-root" wx:if="{{show}}">
  <view class="rp-mask" bindtap="onMaskTap"></view>

  <view class="rp-sheet" catchtap="noop">
    <!-- 标题行：左取消 / 中标题 / 右确定 -->
    <view class="rp-head">
      <view class="rp-head-btn rp-cancel" bindtap="onCancel">取消</view>
      <view class="rp-title">{{title}}</view>
      <view class="rp-head-btn rp-confirm" bindtap="onConfirm">确定</view>
    </view>

    <!-- 面包屑：可点击回退 -->
    <view class="rp-crumbs" wx:if="{{crumbs.length > 0}}">
      <block wx:for="{{crumbs}}" wx:key="level">
        <text class="rp-crumb-sep" wx:if="{{index > 0}}">›</text>
        <text
          class="rp-crumb {{index === crumbs.length - 1 ? 'rp-crumb-active' : ''}}"
          bindtap="onCrumbTap"
          data-level="{{item.level}}"
        >{{item.name}}</text>
      </block>
    </view>

    <!-- 列表：省 → 市 → 区县 逐级下钻 -->
    <scroll-view class="rp-list" scroll-y>
      <view
        class="rp-item {{item.name === county ? 'rp-item-on' : ''}}"
        wx:for="{{list}}"
        wx:key="name"
        bindtap="onItemTap"
        data-name="{{item.name}}"
      >
        <text class="rp-item-text">{{item.label}}</text>
        <text class="rp-item-check" wx:if="{{item.name === county}}">✓</text>
        <text class="rp-item-arrow" wx:elif="{{item.hasChild}}">›</text>
      </view>
    </scroll-view>

    <!-- 语义提示：不选区县即全市，这是货主最常用的粒度 -->
    <view class="rp-tip">不选具体区县，直接点右上「确定」表示全市</view>
  </view>
</view>
