/* 城市选择器 —— 半屏弹层，扁平风格 */

/*
 * ★★ 与 privacy-modal 同样的坑：组件是 styleIsolation: "isolated"，
 *   app.wxss 的全局 .mask 进不来，必须在这里自备，
 *   否则遮罩零尺寸——看不见却仍会吃掉底层点击。
 */
.mask {
  position: absolute;
  inset: 0;
  background-color: rgba(15, 15, 15, 0.6);
}

.cp-root {
  position: fixed;
  inset: 0;
  z-index: 950;
}

.cp-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 78vh;
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(15, 15, 15, 0.16);
}

.cp-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

.cp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #37352F;
}

.cp-close {
  font-size: 32rpx;
  color: #9B9A97;
  padding: 8rpx 12rpx;
}

.cp-search {
  flex-shrink: 0;
  position: relative;
  margin: 0 32rpx 16rpx;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F7F6F3;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
}

.cp-input {
  flex: 1;
  font-size: 28rpx;
  color: #37352F;
}

.cp-placeholder {
  color: #9B9A97;
  font-size: 27rpx;
}

.cp-clear {
  font-size: 26rpx;
  color: #9B9A97;
  padding-left: 16rpx;
}

.cp-body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 32rpx;
}

.cp-sec-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #9B9A97;
  margin: 20rpx 0 12rpx;
}

.cp-hot {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-hot-item {
  padding: 12rpx 28rpx;
  font-size: 27rpx;
  color: #37352F;
  background-color: #F1F1EF;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
}

.cp-hot-item--on {
  background-color: #E7F3F8;
  color: #0B6E99;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-group {
  margin-top: 8rpx;
}

.cp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-cell {
  min-width: 150rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #37352F;
  background-color: #FFFFFF;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
}

.cp-cell--on {
  background-color: #E7F3F8;
  color: #0B6E99;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  background-color: #FFFFFF;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.cp-item--on {
  background-color: #E7F3F8;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-item-name {
  font-size: 28rpx;
  color: #37352F;
}

.cp-item-prov {
  font-size: 24rpx;
  color: #9B9A97;
}

.cp-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #9B9A97;
}
