/* 城市选择器 —— 半屏弹层，扁平风格 */

/*
 * ★★ 与 privacy-modal 同样的坑：组件是 styleIsolation: "isolated"，
 *   app.wxss 的全局 .mask 进不来，必须在这里自备，
 *   否则遮罩零尺寸——看不见却仍会吃掉底层点击。
 */
/*
 * z-index 写死（与 privacy-modal 同一条规则）：
 * 遮罩 0、面板 1，不靠 DOM 顺序决胜，避免「看得见却点不到」。
 * 四边全写开，不用 inset 简写：低版本内核不认 inset，整块会塌成 0 尺寸。
 */
.mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  background-color: rgba(15, 15, 15, 0.6);
}

.cp-root {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 950;
}

.cp-sheet {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  height: 78vh;
  display: flex;
  flex-direction: column;
  background-color: #FFFFFF;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 8rpx 32rpx rgba(15, 15, 15, 0.16);
}

.cp-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}

/* 二级返回按钮：留出和右侧 ✕ 对称的位置，标题才不会歪 */
.cp-back {
  font-size: 40rpx;
  line-height: 1;
  color: #6B6B6B;
  padding: 0 16rpx 0 0;
  min-width: 56rpx;
}

.cp-back:active {
  color: #37352F;
}

.cp-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #37352F;
}

.cp-close {
  font-size: 32rpx;
  color: #9B9A97;
  padding: 8rpx 12rpx;
}

.cp-search {
  flex-shrink: 0;
  position: relative;
  margin: 0 32rpx 16rpx;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  background-color: #F7F6F3;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
}

.cp-input {
  flex: 1;
  font-size: 28rpx;
  color: #37352F;
}

.cp-placeholder {
  color: #9B9A97;
  font-size: 27rpx;
}

.cp-clear {
  font-size: 26rpx;
  color: #9B9A97;
  padding-left: 16rpx;
}

.cp-body {
  flex: 1;
  min-height: 0;
  padding: 0 32rpx 32rpx;
}

.cp-sec-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #9B9A97;
  margin: 20rpx 0 12rpx;
}

.cp-hot {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-hot-item {
  padding: 12rpx 28rpx;
  font-size: 27rpx;
  color: #37352F;
  background-color: #F1F1EF;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
}

.cp-hot-item--on {
  background-color: #E7F3F8;
  color: #0B6E99;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-group {
  margin-top: 8rpx;
}

.cp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-cell {
  min-width: 150rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #37352F;
  background-color: #FFFFFF;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
}

.cp-cell--on {
  background-color: #E7F3F8;
  color: #0B6E99;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  background-color: #FFFFFF;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
  margin-bottom: 12rpx;
}

.cp-item--on {
  background-color: #E7F3F8;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-item-name {
  font-size: 28rpx;
  color: #37352F;
}

.cp-item-prov {
  font-size: 24rpx;
  color: #9B9A97;
}

.cp-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #9B9A97;
}

/* ---- 二级：全市 / 区县 ---- */

/* 「全市」是全宽卡，与下方区县网格拉开层级，用户第一眼就知道可以不选区县 */
.cp-whole {
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx;
  background-color: #FFFFFF;
  border: 1rpx solid rgba(55, 53, 47, 0.09);
  border-radius: 14rpx;
  margin-bottom: 8rpx;
}

.cp-whole:active {
  background-color: #F7F6F3;
}

.cp-whole--on {
  background-color: #E7F3F8;
  border-color: rgba(35, 131, 226, 0.35);
}

.cp-whole-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #37352F;
}

.cp-whole-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9B9A97;
}

/* ---- 搜索结果行 ---- */

.cp-item-main {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cp-item-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9B9A97;
}

.cp-item-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #9B9A97;
}

/*
 * 二级底部说明。
 * 不写这句的后果：用户选了「朝阳区」发现结果和选「北京」一样，
 * 会以为选择器坏了。把规则讲清楚，反而不容易被当成 bug。
 */
.cp-note {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #9B9A97;
  background-color: #F7F6F3;
  border-radius: 12rpx;
}
