/* 线路详情 / 线路公司列表 */

/* 头部 */
.rd-head {
  padding: var(--gap-lg) var(--gap-md) var(--gap-md);
  background-color: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
}

.rd-head-main {
  display: flex;
  align-items: baseline;
  gap: var(--gap-sm);
  flex-wrap: wrap;
}

.rd-title {
  font-size: 42rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.rd-count {
  font-size: 25rpx;
  color: var(--ink-blue);
  background-color: var(--tint-blue);
  border: 1rpx solid var(--edge-blue);
  border-radius: var(--radius-sm);
  padding: 2rpx 14rpx;
}

.rd-head-actions {
  margin-top: var(--gap-md);
  display: flex;
  gap: var(--gap-sm);
}

.rd-head-btn {
  padding: 12rpx 26rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--edge-blue);
  border-radius: var(--radius-sm);
}

.rd-head-btn:active {
  background-color: var(--color-bg-hover);
}

/* 排序 */
.sort-bar {
  display: flex;
  gap: var(--gap-xl);
  padding: var(--gap-md) 4rpx var(--gap-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.sort-item {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  padding-bottom: 12rpx;
  position: relative;
}

.sort-item--on {
  color: var(--color-primary);
  font-weight: 600;
}

.sort-item--on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background-color: var(--color-primary);
  border-radius: 2rpx;
}

/* 过滤 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  margin: var(--gap-sm) 0;
}

.filter-chip {
  padding: 10rpx 24rpx;
  font-size: 25rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-pill);
}

.filter-chip--on {
  color: var(--ink-blue);
  background-color: var(--tint-blue);
  border-color: var(--edge-blue);
}

.filter-reset {
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.rd-filtered {
  padding: 0 4rpx var(--gap-sm);
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ★ 列表：横向对齐
   三列宽度固定：公司列 flex:1 但最小宽度受限，时效/更新列固定宽度右对齐，
   这样纵向扫视时同列能对齐成一条线。 */
.list {
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.col-company {
  flex: 1;
  min-width: 0;
}

.col-transit {
  width: 110rpx;
  flex-shrink: 0;
  text-align: center;
}

.col-updated {
  width: 160rpx;
  flex-shrink: 0;
  text-align: right;
}

.list-head {
  display: flex;
  align-items: center;
  padding: 16rpx var(--gap-md);
  background-color: var(--color-bg-sunken);
  border-bottom: 1rpx solid var(--color-border);
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

.list-row {
  padding: var(--gap-md);
  border-bottom: 1rpx solid var(--color-border);
}

.list-row:last-child {
  border-bottom: none;
}

.lr-line1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--gap-sm);
}

.lr-name-wrap {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  min-width: 0;
}

.lr-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.lr-verified {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--color-badge-verified-text);
  background-color: var(--color-badge-verified-bg);
  border-radius: var(--radius-sm);
  padding: 1rpx 10rpx;
}

.lr-price {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ink-peach);
}

/* 第二行：对齐列 */
.lr-line2 {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.lr-sub {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 第三行：标签 + 操作 */
.lr-line3 {
  margin-top: var(--gap-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-sm);
}

.lr-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.lr-actions {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  flex-shrink: 0;
}

.lr-call {
  padding: 12rpx 22rpx;
  font-size: 25rpx;
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  border-radius: var(--radius-sm);
}

.lr-call:active {
  background-color: var(--color-primary-dark);
}

.lr-call--disabled {
  background-color: var(--color-bg-sunken);
  color: var(--color-text-tertiary);
}

.lr-report {
  font-size: 23rpx;
  color: var(--color-text-tertiary);
  padding: 8rpx;
}

.lr-remark {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-sunken);
  border-radius: var(--radius-sm);
}
