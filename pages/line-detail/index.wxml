<view class="pf-page">
  <block wx:if="{{lineInfo}}">
    <view class="pf-main line-main">
      <!-- ===== 头卡：公司名 + 徽章 + 路线 + 元信息（白底描边，与公司详情同语言） ===== -->
      <view class="pf-card pf-head-card">
        <view class="pf-head-row">
          <text class="pf-name">{{lineInfo.companyName || lineInfo.title}}</text>
          <text class="pf-cert" wx:if="{{lineInfo.certified}}">已核实</text>
          <text class="pf-vip" wx:if="{{lineInfo.isVip}}">👑 会员企业</text>
        </view>
        <view class="pf-meta">
          <text class="pf-meta-item ld-route">{{lineInfo.fromCityName}}</text>
          <text class="pf-meta-sep">→</text>
          <text class="pf-meta-item ld-route">{{lineInfo.toCityName}}</text>
          <block wx:if="{{lineInfo.lineType}}">
            <text class="pf-meta-sep">·</text>
            <text class="pf-meta-item">{{lineInfo.lineType}}</text>
          </block>
          <block wx:if="{{lineInfo.aging}}">
            <text class="pf-meta-sep">·</text>
            <text class="pf-meta-item">{{lineInfo.aging}}</text>
          </block>
        </view>
      </view>

      <!-- ===== 发站信息（蓝卡，多网点编号展示）===== -->
      <view class="pf-card pf-station pf-station-from" wx:if="{{fromPairs.length > 0}}">
        <view class="pf-sc-head">
          <text class="pf-sc-title">发站信息</text>
          <text
            class="pf-sc-act"
            catchtap="onCopyAllAddr"
            data-station="from"
            wx:if="{{fromAddrs.length > 0}}"
          >复制地址</text>
        </view>
        <view class="pf-st-item" wx:for="{{fromPairs}}" wx:key="idx">
          <view class="pf-st-index">{{index + 1}}</view>
          <view class="pf-st-body">
            <view
              class="pf-st-addr"
              wx:if="{{item.addr}}"
              catchtap="onCopyText"
              data-text="{{item.addr}}"
            >{{item.addr}}</view>
            <view class="pf-st-phones" wx:if="{{item.phones.length > 0}}">
              <text
                class="pf-st-phone"
                wx:for="{{item.phones}}"
                wx:for-item="p"
                wx:key="*this"
                catchtap="onCallOne"
                data-phone="{{p}}"
              >
                <text class="pf-st-phone-label">发站电话</text>
                <text class="pf-st-phone-num">{{p}}</text>
              </text>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 到站信息（橙卡）===== -->
      <view class="pf-card pf-station pf-station-to" wx:if="{{toPairs.length > 0}}">
        <view class="pf-sc-head">
          <text class="pf-sc-title">到站信息</text>
          <text
            class="pf-sc-act"
            catchtap="onCopyAllAddr"
            data-station="to"
            wx:if="{{toAddrs.length > 0}}"
          >复制地址</text>
        </view>
        <view class="pf-st-item" wx:for="{{toPairs}}" wx:key="idx">
          <view class="pf-st-index">{{index + 1}}</view>
          <view class="pf-st-body">
            <view
              class="pf-st-addr"
              wx:if="{{item.addr}}"
              catchtap="onCopyText"
              data-text="{{item.addr}}"
            >{{item.addr}}</view>
            <view class="pf-st-phones" wx:if="{{item.phones.length > 0}}">
              <text
                class="pf-st-phone"
                wx:for="{{item.phones}}"
                wx:for-item="p"
                wx:key="*this"
                catchtap="onCallOne"
                data-phone="{{p}}"
              >
                <text class="pf-st-phone-label">到站电话</text>
                <text class="pf-st-phone-num">{{p}}</text>
              </text>
            </view>
          </view>
        </view>
      </view>

      <!-- 两端都没填网点时给一句说明，不留空白 -->
      <view class="pf-card ld-nostation" wx:if="{{fromPairs.length === 0 && toPairs.length === 0}}">
        <view class="ld-nostation-text">该专线暂未填写发站/到站地址与电话，可先通过下方按钮联系平台客服核实。</view>
      </view>

      <!-- ===== 三统计：发站地址 / 联系电话 / 到站地址 ===== -->
      <view class="pf-card pf-stats">
        <view class="pf-stat">
          <view class="pf-stat-num pf-stat-a">{{fromAddrCount}}</view>
          <view class="pf-stat-label">发站地址</view>
        </view>
        <view class="pf-stat">
          <view class="pf-stat-num pf-stat-b">{{phoneList.length}}</view>
          <view class="pf-stat-label">联系电话</view>
        </view>
        <view class="pf-stat">
          <view class="pf-stat-num pf-stat-c">{{toAddrCount}}</view>
          <view class="pf-stat-label">到站地址</view>
        </view>
      </view>

      <!-- ===== 服务信息（覆盖区域 / 运营信息 / 服务优势）===== -->
      <view class="pf-section-head" wx:if="{{hasSpecs || toAreas.length > 0 || (lineInfo.tags && lineInfo.tags.length > 0)}}">
        <text class="pf-section-title">服务信息</text>
      </view>

      <!-- 覆盖区域（74% 填写率，回答"能不能到我这"） -->
      <view class="pf-card" wx:if="{{toAreas.length > 0}}">
        <view class="pf-intro-title">覆盖区域</view>
        <view class="ld-chips">
          <text class="ld-chip ld-chip-green" wx:for="{{toAreas}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <!-- 运营信息（仅展示有值的项，无值整卡隐藏） -->
      <view class="pf-card" wx:if="{{hasSpecs}}">
        <view class="pf-intro-title">运营信息</view>
        <view class="ld-spec-list">
          <view class="ld-spec-row" wx:if="{{lineInfo.aging}}">
            <text class="ld-spec-label">运输时效</text>
            <text class="ld-spec-val ld-spec-key">{{lineInfo.aging}}</text>
          </view>
          <view class="ld-spec-row" wx:if="{{lineInfo.priceDesc}}">
            <text class="ld-spec-label">参考价格</text>
            <text class="ld-spec-val">{{lineInfo.priceDesc}}</text>
          </view>
          <view class="ld-spec-row" wx:if="{{lineInfo.lineType}}">
            <text class="ld-spec-label">运输方式</text>
            <text class="ld-spec-val">{{lineInfo.lineType}}</text>
          </view>
        </view>
      </view>

      <!-- 服务优势标签 -->
      <view class="pf-card" wx:if="{{lineInfo.tags && lineInfo.tags.length > 0}}">
        <view class="pf-intro-title">服务优势</view>
        <view class="ld-chips">
          <text class="ld-chip" wx:for="{{lineInfo.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <!-- 纠错入口：信息由公开渠道整理，必须给出反馈通道 -->
      <view class="pf-report-btn" bindtap="onReport">信息有误？点这里报错</view>

      <view class="pf-footer-note">信息由公开渠道整理，仅供参考，请自行核实</view>
      <view class="ld-bar-space"></view>
    </view>

    <!-- ===== 底部操作栏（磨砂浮层）===== -->
    <view class="ld-bar">
      <view class="ld-bar-tools">
        <button class="ld-tool" open-type="share" hover-class="ld-tool-hover">
          <text class="ld-tool-icon">分享</text>
        </button>
        <view class="ld-tool {{isFav ? 'is-fav' : ''}}" bindtap="toggleFavorite">
          <text class="ld-tool-icon">{{isFav ? '★ 已收藏' : '☆ 收藏'}}</text>
        </view>
      </view>
      <view class="ld-bar-btn ld-btn-nav" bindtap="onOpenMap">导航</view>
      <view class="ld-bar-btn ld-btn-call" bindtap="onCallPhone">立即拨打</view>
    </view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="pf-fallback">
      <view class="pf-empty">
        <view class="pf-empty-title is-error">⚠️ {{loadError}}</view>
        <view class="pf-retry" bindtap="retryLoad">重新加载</view>
        <view class="pf-empty-desc ld-back" bindtap="goBack">返回上一页</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="pf-fallback">
      <view class="pf-empty">
        <view class="pf-empty-title">正在加载专线信息...</view>
      </view>
    </view>
  </block>
</view>
