/* pages/line-detail/index.wxss
 *
 * 视觉语言来自 app.wxss 的 pf-* 类（与公司详情共用）。
 * 本文件只放专线详情独有的部分：
 *   - 页面顶部留白微调
 *   - 复制地址小按钮（pf-sc-act）
 *   - 多电话胶囊竖排（pf-st-phones）
 *   - 筛选标签 / 运营信息行
 *   - 底部操作栏（含分享与收藏）
 */

.pf-page { min-height: 100vh; background: transparent; }
.line-main { padding-top: 20rpx; }

/* 头卡内路线：与元信息同行，用主色强调方向 */
.ld-route { color: var(--ink-body); font-weight: 600; }

/* ---- 站点卡的"复制地址"：右上角轻量文字按钮 ---- */
.pf-sc-act {
  font-size: 22rpx;
  color: var(--brand);
  padding: 4rpx 14rpx;
  background: #ffffff;
  border: 1rpx solid var(--border);
  border-radius: 10rpx;
}
.pf-sc-act:active { opacity: .7; }
.pf-station-to .pf-sc-act { color: var(--sky-amber-ink); }

/* ---- 一个地址可挂多个电话：横向排列，放不下自动换行 ----
 * 【v6.2】.pf-st-phones 已上移到 app.wxss 的 pf-* 体系（两个详情页共用，
 * 避免各写一份造成漂移，符合"pf-* 必须放全局"的既有约定）。 */

/* ---- 两端网点都为空时的说明卡 ---- */
.ld-nostation { padding: 24rpx; }
.ld-nostation-text { font-size: 24rpx; color: var(--ink-muted); line-height: 1.65; }

/* ---- 标签胶囊（覆盖区域 / 服务优势）---- */
.ld-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.ld-chip {
  font-size: 24rpx;
  color: var(--ink-muted);
  background: var(--bg-inset);
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
}
.ld-chip-green {
  color: var(--sky-green-ink);
  background: rgba(233, 244, 230, .95);
  border: 1rpx solid rgba(63, 122, 58, .16);
}

/* ---- 运营信息：标签-值 行 ---- */
.ld-spec-list { display: flex; flex-direction: column; }
.ld-spec-row {
  display: flex; align-items: baseline; gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.ld-spec-row:last-child { border-bottom: none; padding-bottom: 0; }
.ld-spec-label { flex-shrink: 0; width: 140rpx; font-size: 24rpx; color: var(--ink-muted); }
.ld-spec-val {
  flex: 1; min-width: 0;
  font-size: 27rpx; color: var(--ink-body);
  font-weight: 500; line-height: 1.45;
  word-break: break-all;
}
.ld-spec-key { color: #3f8a6a; font-weight: 600; }

/* ===== 底部操作栏：上浮白条，左工具（分享/收藏）+ 右两主按钮 ===== */
.ld-bar-space { height: 140rpx; }
.ld-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -6rpx 24rpx rgba(20, 40, 70, .08);
  z-index: 10;
}
.ld-bar-tools { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.ld-tool {
  margin: 0; padding: 0 14rpx; height: 76rpx; line-height: 76rpx;
  font-size: 21rpx; font-weight: 400;
  background: transparent; color: var(--ink-muted);
  border: none;
}
.ld-tool::after { border: none; }
.ld-tool-hover { opacity: .6; }
.ld-tool.is-fav { color: #a16207; font-weight: 600; }
.ld-tool-icon { font-size: 21rpx; }

.ld-bar-btn {
  height: 80rpx; flex: 1;
  display: flex; align-items: center; justify-content: center;
  border-radius: 18rpx; font-size: 28rpx; font-weight: 600;
  white-space: nowrap;
}
.ld-btn-nav {
  background: #ffffff;
  color: var(--ink-body);
  border: 1rpx solid var(--border-strong);
}
.ld-btn-nav:active { opacity: .75; }
.ld-btn-call {
  flex: 1.5;
  background: linear-gradient(135deg, #3f96ea, #2383e2);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(35, 131, 226, .3);
}
.ld-btn-call:active { opacity: .88; }

/* 错误态里的返回链接 */
.ld-back { margin-top: 24rpx; color: var(--brand); text-decoration: underline; }
