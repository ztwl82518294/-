<view class="pf-page" wx:if="{{company}}">
  <view class="pf-main">
    <!-- ===== 头卡：公司名 + 已核实/会员 + 元信息（白底描边，无渐变） ===== -->
    <view class="pf-card pf-head-card">
      <view class="pf-head-row">
        <text class="pf-name">{{company.companyName}}</text>
        <text class="pf-cert" wx:if="{{company.certified}}">已核实</text>
      </view>
      <view class="pf-meta">
        <block wx:if="{{company.mainCity}}">
          <text class="pf-meta-item">{{company.mainCity}}</text>
        </block>
        <block wx:if="{{company.scale}}">
          <text class="pf-meta-sep" wx:if="{{company.mainCity}}">·</text>
          <text class="pf-meta-item">{{company.scale}}</text>
        </block>
        <block wx:if="{{company.updateText}}">
          <text class="pf-meta-sep">·</text>
          <text class="pf-meta-item">更新: {{company.updateText}}</text>
        </block>
        <block wx:if="{{company.viewCount > 0}}">
          <text class="pf-meta-sep">·</text>
          <text class="pf-meta-item">{{company.viewCount}}次浏览</text>
        </block>
        <block wx:if="{{company.vipCount > 0}}">
          <text class="pf-meta-sep">·</text>
          <text class="pf-meta-item">会员线路 {{company.vipCount}} 条</text>
        </block>
      </view>
    </view>

    <!-- ===== 发站信息（蓝卡）===== -->
    <view class="pf-card pf-station pf-station-from" wx:if="{{company.fromStations.length > 0}}">
      <view class="pf-sc-head">
        <text class="pf-sc-title">发站信息</text>
        <text class="pf-sc-count" wx:if="{{company.fromAddrCount > 0}}">共 {{company.fromAddrCount}} 个</text>
      </view>
      <view class="pf-st-item" wx:for="{{company.fromStations}}" wx:key="idx">
        <view class="pf-st-index">{{index + 1}}</view>
        <view class="pf-st-body">
          <view class="pf-st-addr" wx:if="{{item.addr}}">{{item.addr}}</view>
          <view class="pf-st-phones" wx:if="{{item.phones.length > 0}}">
            <text
              class="pf-st-phone"
              wx:for="{{item.phones}}"
              wx:for-item="p"
              wx:key="*this"
              bindtap="onCallOne"
              data-phone="{{p}}"
            >
              <text class="pf-st-phone-label">发站电话</text>
              <text class="pf-st-phone-num">{{p}}</text>
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 到站信息（橙卡）===== -->
    <view class="pf-card pf-station pf-station-to" wx:if="{{company.toStations.length > 0}}">
      <view class="pf-sc-head">
        <text class="pf-sc-title">到站信息</text>
        <text class="pf-sc-count" wx:if="{{company.toAddrCount > 0}}">共 {{company.toAddrCount}} 个</text>
      </view>
      <view class="pf-st-item" wx:for="{{company.toStations}}" wx:key="idx">
        <view class="pf-st-index">{{index + 1}}</view>
        <view class="pf-st-body">
          <view class="pf-st-addr" wx:if="{{item.addr}}">{{item.addr}}</view>
          <view class="pf-st-phones" wx:if="{{item.phones.length > 0}}">
            <text
              class="pf-st-phone"
              wx:for="{{item.phones}}"
              wx:for-item="p"
              wx:key="*this"
              bindtap="onCallOne"
              data-phone="{{p}}"
            >
              <text class="pf-st-phone-label">到站电话</text>
              <text class="pf-st-phone-num">{{p}}</text>
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- ===== 公司简介（无内容整卡隐藏）===== -->
    <view class="pf-card" wx:if="{{company.summary}}">
      <view class="pf-intro-title">公司简介</view>
      <view class="pf-intro-text">{{company.summary}}</view>
    </view>

    <!-- ===== 三统计：出发城市 / 覆盖线路 / 到达城市 ===== -->
    <view class="pf-card pf-stats">
      <view class="pf-stat">
        <view class="pf-stat-num pf-stat-a">{{company.fromCityCount}}</view>
        <view class="pf-stat-label">出发城市</view>
      </view>
      <view class="pf-stat">
        <view class="pf-stat-num pf-stat-b">{{company.lineCount}}</view>
        <view class="pf-stat-label">覆盖线路</view>
      </view>
      <view class="pf-stat">
        <view class="pf-stat-num pf-stat-c">{{company.toCityCount}}</view>
        <view class="pf-stat-label">到达城市</view>
      </view>
    </view>

    <!-- ===== 覆盖线路（按出发城市分组）===== -->
    <view class="pf-section-head">
      <text class="pf-section-title">覆盖线路</text>
      <text class="pf-section-sub">按出发城市分组</text>
    </view>

    <view class="pf-group" wx:for="{{company.groups}}" wx:for-item="grp" wx:key="city">
      <view class="pf-group-head">
        <text class="pf-group-city">{{grp.city}}</text>
        <text class="pf-group-count">{{grp.lines.length}} 条</text>
      </view>
      <view
        class="pf-route-row"
        wx:for="{{grp.lines}}"
        wx:for-item="r"
        wx:key="ref"
        bindtap="goLine"
        data-ref="{{r.ref}}"
      >
        <text class="pf-rr-city">{{r.toCityName}}</text>
        <view class="pf-rr-tags">
          <text class="pf-rr-tag {{r.transfer ? 'pf-rr-transfer' : 'pf-rr-direct'}}">{{r.transfer ? '中转' : '直达'}}</text>
          <text class="pf-rr-tag pf-rr-plain" wx:if="{{r.aging}}">{{r.aging}}</text>
          <text class="pf-rr-tag pf-rr-daily" wx:if="{{r.daily}}">天天发车</text>
        </view>
        <text class="pf-rr-arrow">›</text>
      </view>
    </view>

    <!-- 纠错入口：信息由公开渠道整理，必须给出反馈通道 -->
    <view class="pf-report-btn" bindtap="onReport">信息有误？点这里报错</view>

    <view class="pf-footer-note">信息由公开渠道整理，仅供参考，请自行核实</view>
  </view>
</view>

<!-- 加载失败 / 公司无在营线路 -->
<view class="pf-fallback" wx:elif="{{loadError}}">
  <view class="pf-empty">
    <view class="pf-empty-title is-error">⚠️ 加载失败</view>
    <view class="pf-empty-desc">{{errorMsg}}</view>
    <view class="pf-retry" bindtap="retryLoad">重新加载</view>
  </view>
</view>

<view class="pf-fallback" wx:else>
  <view class="pf-empty">
    <view class="pf-empty-title">加载中...</view>
  </view>
</view>
