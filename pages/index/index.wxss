/* 首页 */

/* 品牌区 */
.hero {
  padding: 40rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: var(--color-text-secondary);
}

/* 搜索框 */
.home-search {
  margin-bottom: var(--gap-md);
  height: 92rpx;
}

.home-search-btn {
  flex-shrink: 0;
  padding: 0 32rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  border-radius: var(--radius-sm);
}

.home-search-btn:active {
  background-color: var(--color-primary-dark);
}

/* 快捷入口 */
.entry-row {
  display: flex;
  gap: var(--gap-md);
  margin-bottom: var(--gap-md);
}

.entry-card {
  flex: 1;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-md);
}

.entry-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--color-text-secondary);
}

/* 热门专线 */
.hot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.hot-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.hot-main {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  min-width: 0;
}

.hot-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.hot-count {
  font-size: 23rpx;
  color: var(--ink-blue);
  background-color: var(--tint-blue);
  border: 1rpx solid var(--edge-blue);
  border-radius: var(--radius-sm);
  padding: 2rpx 12rpx;
}

.hot-arrow {
  font-size: 32rpx;
  color: var(--color-text-tertiary);
  flex-shrink: 0;
}

/* 最近更新 */
.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.recent-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.recent-main {
  display: flex;
  align-items: center;
  gap: var(--gap-xs);
  min-width: 0;
}

.recent-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.recent-time {
  flex-shrink: 0;
  margin-left: var(--gap-sm);
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

/* 空态（区块内联，比整页空态轻） */
.empty-inline {
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}

/* 区块内联的失败重试（加载失败时替代空文案，避免把异常说成「没数据」） */
.empty-inline-text {
  display: block;
  font-size: 25rpx;
  color: var(--color-text-tertiary);
}

.empty-inline-btn {
  display: inline-block;
  margin-top: var(--gap-sm);
  padding: 10rpx 32rpx;
  font-size: 25rpx;
  color: var(--color-primary);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--edge-blue);
  border-radius: var(--radius-sm);
}

.empty-inline-btn:active {
  background-color: var(--color-bg-hover);
}

/* 底部公示 */
.foot {
  margin-top: var(--gap-xl);
  padding: 0 8rpx 40rpx;
}

.foot-updated {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.foot-brief {
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--color-text-tertiary);
}

.foot-links {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.foot-link {
  font-size: 25rpx;
  color: var(--color-primary);
}

.foot-sep {
  font-size: 25rpx;
  color: var(--color-text-tertiary);
}

.foot-operator {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}
