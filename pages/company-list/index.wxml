<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view class="hero-head">
        <view class="hero-title">查公司</view>
        <view class="hero-sub">输入公司名，查看它的全部专线</view>
      </view>
      <!-- 「我的」从 tabBar 让位后移到此处，保留收藏/历史/客服入口 -->
      <view class="me-btn" bindtap="goMine">我的</view>
    </view>

    <view class="search-row">
      <view class="search-bar">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="输入公司名，如 齐鲁 / 鲁通物流"
          placeholder-class="search-ph"
          value="{{keyword}}"
          confirm-type="search"
          bindinput="onInput"
          bindconfirm="onSearch"
        />
        <view class="search-clear" wx:if="{{keyword}}" bindtap="clearKeyword">✕</view>
      </view>
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <view class="main">
    <!-- 搜索结果：找到 N 家公司 -->
    <view class="result-head" wx:if="{{searched && !loading && !loadError}}">
      <text class="result-count">找到 {{total}} 家公司</text>
    </view>

    <block wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-line skeleton-title"></view>
        <view class="skeleton-line skeleton-text"></view>
        <view class="skeleton-line skeleton-text short"></view>
      </view>
    </block>

    <block wx:elif="{{loadError}}">
      <view class="empty-card">
        <view class="empty-title error">⚠️ 查询失败</view>
        <view class="empty-desc">{{errorMsg}}</view>
        <view class="retry-btn" bindtap="onRetry">重新查询</view>
      </view>
    </block>

    <block wx:elif="{{companyList.length > 0}}">
      <view
        wx:for="{{companyList}}"
        wx:key="companyName"
        class="company-card"
        bindtap="goToDetail"
        data-name="{{item.companyName}}"
      >
        <view class="cc-body">
          <view class="cc-head">
            <text class="cc-name">{{item.companyName}}</text>
            <text class="cc-cert" wx:if="{{item.certified}}">已核实</text>
          </view>
          <view class="cc-meta">
            <block wx:if="{{item.mainCity}}">
              <text class="cc-meta-item">{{item.mainCity}}</text>
            </block>
            <block wx:if="{{item.scale}}">
              <text class="cc-dot" wx:if="{{item.mainCity}}">·</text>
              <text class="cc-meta-item">{{item.scale}}</text>
            </block>
            <text class="cc-dot">·</text>
            <text class="cc-meta-item">{{item.lineCount}} 条线路</text>
            <block wx:if="{{item.updateText}}">
              <text class="cc-dot">·</text>
              <text class="cc-meta-item">更新: {{item.updateText}}</text>
            </block>
          </view>
        </view>
        <text class="cc-arrow">›</text>
      </view>
    </block>

    <block wx:elif="{{searched}}">
      <view class="empty-card">
        <view class="empty-title">没有找到「{{keyword}}」相关公司</view>
        <view class="empty-desc">试试输入公司名的一部分，比如「齐鲁」「鲁通」<br/>或直接去「查专线」按地址查</view>
      </view>
    </block>

    <!-- 未搜索时的引导态 -->
    <block wx:else>
      <view class="empty-card">
        <view class="empty-title">输入公司名开始查询</view>
        <view class="empty-desc">支持公司简称，如输入「齐鲁」<br/>可查到「山东齐鲁快运有限公司」</view>
      </view>
    </block>

    <view class="footer-note">信息由公开渠道整理，仅供参考，请自行核实</view>
  </view>
</view>
