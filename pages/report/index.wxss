/* pages/report/index.wxss
 *
 * 信息纠错表单。配色一律走 app.wxss 的设计令牌，本文件不写死色值。
 * 版式参照参考图：白底分区 + 细分隔线，底部固定主色提交按钮。
 */

.rp-page { min-height: 100vh; background: transparent; }
/* 没有渐变头图（表单页不是浏览页），内容直接铺开 */
.rp-main { padding: 20rpx 28rpx 0; }

/* ---- ① 你要反馈的信息：琥珀提示条 ---- */
.rp-target {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 26rpx;
  background: rgba(255, 250, 240, .96);
  border: 1rpx solid rgba(212, 160, 60, .22);
}
.rp-target-label { font-size: 23rpx; color: var(--ink-muted); }
.rp-target-name {
  margin-top: 8rpx;
  font-size: 30rpx; font-weight: 600; color: var(--ink-title);
  line-height: 1.45; word-break: break-all;
}

/* ---- 通用分区 ---- */
.rp-block { margin-bottom: 36rpx; }
.rp-label {
  display: flex; align-items: baseline;
  margin-bottom: 18rpx;
}
.rp-label-text { font-size: 28rpx; font-weight: 600; color: var(--ink-title); }
.rp-req { font-size: 26rpx; color: #d0473c; margin-left: 6rpx; }
.rp-counter { margin-left: auto; font-size: 22rpx; color: var(--ink-muted); }
.rp-opt { margin-left: auto; font-size: 22rpx; color: var(--ink-muted); }

/* ---- ② 问题类型 chips：单选，选中有主色描边 + 浅蓝底 ---- */
.rp-chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.rp-chip {
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  font-size: 26rpx; color: var(--ink-body);
  background: #ffffff;
  border: 1rpx solid var(--border-strong);
}
.rp-chip:active { opacity: .75; }
.rp-chip.is-on {
  color: var(--brand-deep);
  font-weight: 600;
  background: var(--brand-wash);
  border-color: rgba(35, 131, 226, .38);
}

/* ---- ③ 具体说明 textarea ---- */
.rp-textarea {
  width: 100%; height: 240rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx; color: var(--ink-body); line-height: 1.65;
  background: #ffffff;
  border: 1rpx solid var(--border-strong);
}
.rp-ph { color: var(--ink-disabled); font-size: 25rpx; }

/* ---- ④ 上传凭证 ---- */
.rp-uploads { display: flex; flex-wrap: wrap; gap: 20rpx; }
.rp-thumb { position: relative; width: 160rpx; height: 160rpx; }
.rp-thumb-img { width: 160rpx; height: 160rpx; border-radius: 14rpx; background: var(--bg-inset); }
.rp-thumb-del {
  position: absolute; top: -10rpx; right: -10rpx;
  width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  border-radius: 50%;
  background: rgba(55, 53, 47, .72);
  color: #fff; font-size: 30rpx;
}
/* 添加框：虚线描边 + 主色加号，与参考图一致 */
.rp-add {
  width: 160rpx; height: 160rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  border-radius: 14rpx;
  border: 2rpx dashed rgba(35, 131, 226, .35);
  background: rgba(240, 247, 255, .6);
}
.rp-add:active { opacity: .7; }
.rp-add-plus { font-size: 52rpx; color: var(--brand); line-height: 1; font-weight: 300; }
.rp-add-text { font-size: 22rpx; color: var(--brand); margin-top: 8rpx; }

/* ---- ⑤ 联系方式 input ---- */
.rp-input {
  width: 100%; box-sizing: border-box;
  height: 88rpx; padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 26rpx; color: var(--ink-body);
  background: #ffffff;
  border: 1rpx solid var(--border-strong);
}

/* ---- ⑥ 流程说明条 ---- */
.rp-note {
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  font-size: 23rpx; color: var(--ink-muted); line-height: 1.6;
  background: var(--bg-inset);
}

/* ---- ⑦ 固定底栏 ---- */
/* 留出底栏高度的空白，否则最后的说明条会被底栏盖住 */
.rp-bar-space { height: 180rpx; }
.rp-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid var(--border);
  box-shadow: 0 -6rpx 24rpx rgba(20, 40, 70, .08);
  z-index: 10;
}
.rp-submit {
  height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 18rpx;
  font-size: 30rpx; font-weight: 600; color: #fff;
  background: linear-gradient(135deg, #3f96ea, #2383e2);
  box-shadow: 0 8rpx 20rpx rgba(35, 131, 226, .3);
}
.rp-submit:active { opacity: .88; }
/* 提交中：降透明度并禁用点击（onSubmit 里还有 lock 兜底） */
.rp-submit.is-busy { opacity: .6; }
