.page{min-height:100vh;background:var(--bg-page);}
.route-banner{background:linear-gradient(135deg,var(--brand),var(--brand-light));padding:40rpx 30rpx 60rpx;border-radius:0 0 44rpx 44rpx;text-align:center;}
.route-text{color:#fff;font-size:40rpx;font-weight:bold;}
.route-count{color:rgba(255,255,255,.85);font-size:24rpx;margin-top:10rpx;}
.list-main{padding:0 24rpx 40rpx;margin-top:-30rpx;}

/* 骨架屏 */
@keyframes shimmer{0%{background-position:-400rpx 0;}100%{background-position:400rpx 0;}}
.skeleton-card{background:#fff;border-radius:24rpx;padding:26rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(31,45,61,.06);}
.skeleton-line{background:linear-gradient(90deg,#f0f0f0 25%,#e0e0e0 50%,#f0f0f0 75%);background-size:800rpx 100%;animation:shimmer 1.2s infinite linear;border-radius:8rpx;margin-bottom:16rpx;}
.skeleton-title{width:60%;height:36rpx;}
.skeleton-text{width:90%;height:26rpx;}
.skeleton-text.short{width:40%;}
.loading-tip{text-align:center;font-size:24rpx;color:var(--ink-muted);padding:20rpx 0;}

/* 专线卡片 */
.line-card{background:#fff;border-radius:24rpx;padding:26rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(31,45,61,.06);}
.line-card:active{background:#f9fafb;}
.line-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx;}
.line-title{font-size:32rpx;font-weight:bold;color:var(--ink-title);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.line-badges{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;flex-shrink:0;}
.line-type{font-size:22rpx;color:var(--brand);background:var(--brand-wash);padding:4rpx 12rpx;border-radius:6rpx;}
.line-company{font-size:26rpx;color:#64748b;margin-bottom:12rpx;}
.line-route{font-size:28rpx;color:#334155;margin-bottom:12rpx;}
.line-info{display:flex;justify-content:space-between;font-size:24rpx;color:#64748b;margin-bottom:16rpx;}
.line-aging{color:#059669;}
.line-tags{display:flex;flex-wrap:wrap;gap:12rpx;}
.tag-item{font-size:22rpx;color:#64748b;background:#f1f5f9;padding:6rpx 16rpx;border-radius:6rpx;}

/* 中转徽章 */
.transfer-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:20rpx;background:#fff7ed;color:#ea580c;border:1rpx solid #ffedd5;font-size:20rpx;font-weight:bold;}

/* 认证徽章（会员徽章样式统一在 app.wxss 的 vip-badge-shine 定义） */
.cert-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:20rpx;background:var(--brand-wash);color:var(--brand-deep);font-size:20rpx;font-weight:bold;}

/* 空状态 */
.empty-card{background:#fff;border-radius:24rpx;text-align:center;padding:60rpx 24rpx;}
.empty-title{font-size:32rpx;font-weight:bold;color:var(--ink-title);margin-bottom:12rpx;}
.empty-title.error{color:#dc2626;}
.empty-desc{font-size:26rpx;color:var(--ink-muted);line-height:1.6;}
/* 错误态重试按钮 */
.retry-btn{
  margin:32rpx auto 0;
  width:260rpx;
  height:72rpx;
  line-height:72rpx;
  border-radius:36rpx;
  background:linear-gradient(135deg,var(--brand),var(--brand-light));
  color:#fff;
  font-size:28rpx;
  font-weight:bold;
  box-shadow:0 8rpx 20rpx rgba(37,99,235,.25);
}
.retry-btn:active{opacity:.85;}
/* 直达徽章 */
.direct-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:20rpx;background:#d1fae5;color:#059669;font-size:20rpx;font-weight:bold;}

/* 中转方案 */
.transfer-tip{font-size:24rpx;color:#ea580c;background:#fff7ed;padding:16rpx 24rpx;border-radius:16rpx;margin-bottom:20rpx;text-align:center;}
.transfer-card{background:#fff;border-radius:24rpx;padding:24rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(31,45,61,.06);}
.transfer-leg{background:#f8fafc;border-radius:16rpx;padding:20rpx;}
.transfer-leg:active{background:#f1f5f9;}
.leg-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx;}
.leg-label{font-size:22rpx;color:var(--brand);background:var(--brand-wash);padding:4rpx 14rpx;border-radius:12rpx;font-weight:bold;}
.leg-company{font-size:26rpx;color:#334155;font-weight:bold;}
.leg-route{font-size:30rpx;font-weight:bold;color:var(--ink-title);margin-bottom:8rpx;}
.leg-info{display:flex;justify-content:space-between;font-size:22rpx;color:#64748b;}
.transfer-arrow{display:flex;align-items:center;justify-content:center;margin:16rpx 0;}
.arrow-line{flex:1;height:2rpx;background:#e2e8f0;}
.arrow-circle{background:#fff7ed;color:#ea580c;font-size:22rpx;padding:8rpx 20rpx;border-radius:20rpx;border:2rpx solid #fed7aa;margin:0 12rpx;white-space:nowrap;}
.transfer-summary{font-size:24rpx;color:#64748b;text-align:center;margin-top:16rpx;padding-top:16rpx;border-top:2rpx dashed #e2e8f0;}