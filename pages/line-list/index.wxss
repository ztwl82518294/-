.page{min-height:100vh;background:transparent;}

/* ===== 顶部渐变标题区（macOS 天气风） ===== */
.route-banner{
  background:linear-gradient(158deg, #3d7fd4 0%, #5b9ce4 42%, #8dbcee 78%, #a8cdf2 100%);
  padding:48rpx 32rpx 100rpx;
  border-radius:0 0 40rpx 40rpx;
  text-align:left;
  position:relative;overflow:hidden;
}
.route-banner::before{
  content:'';position:absolute;top:-40%;left:-10%;
  width:80%;height:120%;
  background:radial-gradient(ellipse at center, rgba(255,255,255,.96) 0%, transparent 68%);
  pointer-events:none;
}
.route-text{color:#fff;font-size:42rpx;font-weight:600;letter-spacing:-.4rpx;line-height:1.3;position:relative;text-shadow:0 2rpx 12rpx rgba(30,60,110,.18);}
.route-count{color:#ffffff;font-size:24rpx;margin-top:10rpx;position:relative;text-shadow:0 1rpx 8rpx rgba(30,60,110,.14);}
.list-main{padding:0 28rpx 60rpx;margin-top:-60rpx;position:relative;z-index:2;}

/* ===== 筛选条（与查专线页同一套 chip 语言） ===== */
.filter-bar{display:flex;flex-wrap:wrap;align-items:center;gap:14rpx;margin-bottom:20rpx;}
.fchip{
  display:flex;align-items:center;gap:8rpx;
  padding:12rpx 22rpx;border-radius:14rpx;
  font-size:23rpx;color:var(--ink-muted);
  background:rgba(255,255,255,.96);
  border:1rpx solid #ffffff;
}
.fchip:active{transform:scale(.96);}
.fchip-box{
  width:26rpx;height:26rpx;border-radius:7rpx;
  border:2rpx solid #bfcbd8;
  display:flex;align-items:center;justify-content:center;
  font-size:19rpx;color:#fff;line-height:1;box-sizing:border-box;flex-shrink:0;
}
.fchip-on{
  color:#fff;background:linear-gradient(135deg,#3f96ea,#2383e2);
  border-color:transparent;box-shadow:0 4rpx 12rpx rgba(35,131,226,.26);
}
.fchip-on .fchip-box{background:rgba(255,255,255,.96);border-color:transparent;}
.fchip-clear{font-size:23rpx;color:var(--brand);padding:12rpx 8rpx;}
.fchip-clear:active{opacity:.6;}

/* 骨架屏 */
@keyframes shimmer{0%{background-position:-400rpx 0;}100%{background-position:400rpx 0;}}
.skeleton-card{
  background:rgba(255,255,255,.96);border-radius:24rpx;padding:26rpx;margin-bottom:18rpx;
  border:1rpx solid #ffffff;box-shadow:var(--shadow-card);
}
.skeleton-line{background:linear-gradient(90deg,rgba(230,235,242,.8) 25%,rgba(215,222,232,.9) 50%,rgba(230,235,242,.8) 75%);background-size:800rpx 100%;animation:shimmer 1.2s infinite linear;border-radius:10rpx;margin-bottom:16rpx;}
.skeleton-title{width:60%;height:36rpx;}
.skeleton-text{width:90%;height:26rpx;}
.skeleton-text.short{width:40%;}
.loading-tip{text-align:center;font-size:24rpx;color:var(--ink-muted);padding:20rpx 0;}

/* ===== 专线卡片（白色实心 + 大圆角 + 柔和投影） ===== */
.line-card{
  background:#ffffff;
  border:1rpx solid #ffffff;
  border-radius:24rpx;
  padding:26rpx;margin-bottom:18rpx;
  box-shadow:var(--shadow-card);
}
.line-card:active{background:#ffffff;}
.line-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx;}
.line-title{font-size:32rpx;font-weight:600;color:var(--ink-title);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.2rpx;}
.line-badges{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;flex-shrink:0;}
/* 标签：浅底小胶囊 */
.line-type{font-size:22rpx;color:var(--brand-deep);background:rgba(35,131,226,.1);padding:4rpx 12rpx;border-radius:10rpx;}
.line-company{font-size:26rpx;color:var(--ink-muted);margin-bottom:10rpx;}
.line-route{font-size:28rpx;color:var(--ink-body);margin-bottom:10rpx;}
.line-info{display:flex;justify-content:space-between;font-size:24rpx;color:var(--ink-muted);margin-bottom:16rpx;}
.line-aging{color:#3f8a6a;}
.line-tags{display:flex;flex-wrap:wrap;gap:10rpx;}
.tag-item{font-size:22rpx;color:var(--ink-muted);background:var(--bg-inset);padding:6rpx 16rpx;border-radius:10rpx;}

/* 中转徽章 */
.transfer-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:10rpx;background:rgba(253,243,227,.9);color:var(--sky-amber-ink);border:1rpx solid #ffffff;font-size:20rpx;font-weight:600;}

/* 认证徽章（会员徽章样式统一在 app.wxss 的 vip-badge-shine 定义） */
.cert-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:10rpx;background:rgba(35,131,226,.1);color:var(--brand-deep);font-size:20rpx;font-weight:600;}

/* 空状态 */
.empty-card{
  background:#ffffff;
  border:1rpx solid #ffffff;
  border-radius:24rpx;text-align:center;padding:60rpx 24rpx;
  box-shadow:var(--shadow-card);
}
.empty-title{font-size:32rpx;font-weight:600;color:var(--ink-title);margin-bottom:12rpx;}
.empty-title.error{color:#c4554d;}
.empty-desc{font-size:26rpx;color:var(--ink-muted);line-height:1.6;}
/* 错误态重试按钮 */
.retry-btn{
  margin:32rpx auto 0;
  width:260rpx;height:76rpx;line-height:76rpx;
  border-radius:20rpx;
  background:linear-gradient(135deg,#3f96ea,#2383e2);
  color:#fff;font-size:28rpx;font-weight:600;
  box-shadow:0 8rpx 22rpx rgba(35,131,226,.3);
}
.retry-btn:active{opacity:.9;}
/* 直达徽章 */
.direct-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:10rpx;background:rgba(233,244,230,.92);color:var(--sky-green-ink);font-size:20rpx;font-weight:600;}

/* ===== 中转方案 ===== */
.transfer-tip{
  font-size:24rpx;color:var(--sky-amber-ink);
  background:rgba(253,243,227,.88);
  border:1rpx solid #ffffff;
  padding:18rpx 24rpx;border-radius:18rpx;margin-bottom:18rpx;text-align:center;
}
.transfer-card{
  background:#ffffff;
  border:1rpx solid #ffffff;
  border-radius:24rpx;padding:24rpx;margin-bottom:18rpx;
  box-shadow:var(--shadow-card);
}
.transfer-leg{background:rgba(255,255,255,.96);border:1rpx solid rgba(255,255,255,.98);border-radius:18rpx;padding:20rpx;}
.transfer-leg:active{background:rgba(255,255,255,.98);}
.leg-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx;}
.leg-label{font-size:22rpx;color:var(--brand-deep);background:rgba(35,131,226,.1);padding:4rpx 14rpx;border-radius:10rpx;font-weight:600;}
.leg-company{font-size:26rpx;color:var(--ink-body);font-weight:600;}
.leg-route{font-size:30rpx;font-weight:600;color:var(--ink-title);margin-bottom:8rpx;}
.leg-info{display:flex;justify-content:space-between;font-size:22rpx;color:var(--ink-muted);}
.transfer-arrow{display:flex;align-items:center;justify-content:center;margin:16rpx 0;}
.arrow-line{flex:1;height:1rpx;background:rgba(120,140,170,.24);}
.arrow-circle{background:rgba(253,243,227,.9);color:var(--sky-amber-ink);font-size:22rpx;padding:8rpx 20rpx;border-radius:14rpx;border:1rpx solid #ffffff;margin:0 12rpx;white-space:nowrap;}
.transfer-summary{font-size:24rpx;color:var(--ink-muted);text-align:center;margin-top:16rpx;padding-top:16rpx;border-top:1rpx dashed rgba(120,140,170,.24);}
