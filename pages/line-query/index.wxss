/* 页面底色由 app.wxss 的天空渐变提供，此处不再覆盖 */
.page{min-height:100vh;background:transparent;}

/* ===== 头图（与首页同一套天空渐变，保证 tab 切换视觉连续） ===== */
.hero{
  padding:48rpx 32rpx 92rpx;
  background:linear-gradient(158deg, #3d7fd4 0%, #5b9ce4 42%, #8dbcee 78%, #a8cdf2 100%);
  border-radius:0 0 40rpx 40rpx;
  position:relative;
  overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:-40%;left:-10%;width:80%;height:120%;
  background:radial-gradient(ellipse at center, rgba(255,255,255,.96) 0%, transparent 68%);
  pointer-events:none;
}
.hero-top{display:flex;align-items:flex-start;justify-content:space-between;position:relative;gap:20rpx;}
.hero-head{flex:1;min-width:0;}
.hero-title{color:#fff;font-size:42rpx;font-weight:600;letter-spacing:-.4rpx;line-height:1.25;position:relative;text-shadow:0 2rpx 12rpx rgba(30,60,110,.18);}
.hero-sub{color:#ffffff;font-size:25rpx;margin-top:10rpx;line-height:1.5;position:relative;text-shadow:0 1rpx 8rpx rgba(30,60,110,.14);}
/* 收藏按钮：白底蓝字小胶囊 */
.fav-btn{
  flex-shrink:0;
  padding:12rpx 26rpx;
  border-radius:16rpx;
  background:rgba(255,255,255,.96);
  border:1rpx solid rgba(255,255,255,.96);
  color:#2b6cb0;font-size:25rpx;font-weight:500;
  margin-top:6rpx;
}
.fav-btn:active{background:#eef4fb;}

.main{padding:0 28rpx 60rpx;margin-top:-60rpx;position:relative;z-index:2;}

/* ===== 地址双卡（出发地蓝 / 目的地橙，场景色与首页入口卡呼应） ===== */
.route-card{
  display:flex;align-items:stretch;
  background:#ffffff;
  border:1rpx solid #ffffff;
  border-radius:26rpx;
  padding:22rpx;
  box-shadow:0 4rpx 12rpx rgba(20,40,70,.06), 0 18rpx 44rpx rgba(20,40,70,.1);
  gap:14rpx;
}
.addr-box{
  flex:1;min-width:0;
  border-radius:20rpx;
  padding:22rpx 22rpx;
  display:flex;flex-direction:column;justify-content:center;
  min-height:108rpx;
  transition:transform .12s ease;
}
.addr-box:active{transform:scale(.98);}
/* 出发地：浅蓝（信息/起点） */
.addr-from{background:rgba(228,240,254,.95);border:1rpx solid #ffffff;}
/* 目的地：浅橙（行动/终点） */
.addr-to{background:rgba(255,241,229,.95);border:1rpx solid #ffffff;}
.addr-label{font-size:22rpx;color:var(--ink-muted);letter-spacing:.4rpx;}
.addr-value{
  font-size:32rpx;font-weight:600;margin-top:10rpx;line-height:1.3;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.addr-from .addr-value{color:#1c6bb0;}
.addr-to .addr-value{color:#a06a12;}
.addr-placeholder{font-weight:400;font-size:28rpx;}
.addr-from .addr-placeholder{color:#8fb4d6;}
.addr-to .addr-placeholder{color:#d8ab7e;}

/* 交换按钮：中线圆形 */
.addr-swap{
  align-self:center;flex-shrink:0;
  width:64rpx;height:64rpx;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:30rpx;color:var(--brand);
  background:rgba(35,131,226,.1);
  border:1rpx solid #ffffff;
  box-shadow:0 2rpx 8rpx rgba(35,131,226,.12);
}
.addr-swap:active{background:rgba(35,131,226,.2);}

/* ===== 筛选行：胶囊 chip ===== */
.filter-row{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx;}
.fchip{
  display:flex;align-items:center;gap:8rpx;
  padding:12rpx 22rpx;
  border-radius:14rpx;
  font-size:23rpx;color:var(--ink-muted);
  background:rgba(255,255,255,.96);
  border:1rpx solid #ffffff;
  transition:transform .1s ease;
}
.fchip:active{transform:scale(.96);}
/* 勾选框：未选中为空心 */
.fchip-box{
  width:26rpx;height:26rpx;border-radius:7rpx;
  border:2rpx solid #bfcbd8;
  display:flex;align-items:center;justify-content:center;
  font-size:19rpx;color:#fff;line-height:1;
  box-sizing:border-box;flex-shrink:0;
}
/* 选中态：主色胶囊 + 实心勾 */
.fchip-on{
  color:#fff;
  background:linear-gradient(135deg,#3f96ea,#2383e2);
  border-color:transparent;
  box-shadow:0 4rpx 12rpx rgba(35,131,226,.26);
}
.fchip-on .fchip-box{background:#ffffff;border-color:transparent;}
.fchip-caret{font-size:20rpx;opacity:.8;}

/* ===== 查询按钮 ===== */
.query-btn{
  margin-top:26rpx;height:92rpx;line-height:92rpx;text-align:center;
  border-radius:22rpx;
  background:linear-gradient(135deg, #3f96ea 0%, #2383e2 100%);
  color:#fff;font-size:30rpx;font-weight:600;
  box-shadow:0 8rpx 22rpx rgba(35,131,226,.32);
}
.query-btn:active{opacity:.9;}
/* 未选齐地址时置灰，但仍可点击（点击后给 toast 引导，避免"点了没反应"） */
.query-btn-disabled{
  background:rgba(190,200,214,.5);
  box-shadow:none;
  color:#ffffff;
}

/* ===== 空态卡 ===== */
.empty-card{
  margin-top:32rpx;
  padding:64rpx 40rpx;
  border-radius:26rpx;
  background:#ffffff;
  border:1rpx solid #ffffff;
  box-shadow:var(--shadow-card);
  text-align:center;
}
.empty-title{font-size:32rpx;font-weight:600;color:var(--ink-title);}
.empty-sub{font-size:24rpx;color:var(--ink-muted);margin-top:16rpx;line-height:1.6;}

/* 已选地址后的就绪卡 */
.ready-card{
  margin-top:32rpx;
  padding:48rpx 36rpx;
  border-radius:26rpx;
  background:#ffffff;
  border:1rpx solid #ffffff;
  box-shadow:var(--shadow-card);
  text-align:center;
}
.ready-route{font-size:34rpx;font-weight:600;color:var(--ink-title);line-height:1.35;}
.ready-sub{font-size:23rpx;color:var(--ink-muted);margin-top:16rpx;line-height:1.65;}

/* ===== 返回首页 ===== */
.home-btn{
  margin-top:26rpx;height:88rpx;line-height:88rpx;text-align:center;
  border-radius:22rpx;
  background:#ffffff;
  border:1rpx solid #ffffff;
  color:var(--ink-body);font-size:27rpx;font-weight:500;
  box-shadow:var(--shadow-card);
}
.home-btn:active{opacity:.75;}
