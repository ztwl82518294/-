<view class="page">
  <view class="hero">
    <view class="hero-top">
      <view class="hero-head">
        <view class="hero-title">按地址查专线</view>
        <view class="hero-sub">选择出发地与目的地，查跑这条线的物流公司</view>
      </view>
      <!-- 收藏入口：收藏从 tabBar 让位后移到此处 -->
      <view class="fav-btn" bindtap="goFavorite">收藏</view>
    </view>
  </view>

  <view class="main">
    <!-- 出发地 / 目的地 双卡 + 中间交换 -->
    <view class="route-card">
      <view class="addr-box addr-from" bindtap="pickFrom">
        <view class="addr-label">出发地</view>
        <view class="addr-value {{fromText ? '' : 'addr-placeholder'}}">{{fromText || '请选择'}}</view>
      </view>

      <view class="addr-swap" bindtap="swapCity">⇄</view>

      <view class="addr-box addr-to" bindtap="pickTo">
        <view class="addr-label">目的地</view>
        <view class="addr-value {{toText ? '' : 'addr-placeholder'}}">{{toText || '请选择省/市/区县'}}</view>
      </view>
    </view>

    <!-- 筛选条件：只看直达 / 天天发车 / 时效 -->
    <view class="filter-row">
      <view class="fchip {{filters.direct ? 'fchip-on' : ''}}" bindtap="toggleDirect">
        <text class="fchip-box">{{filters.direct ? '✓' : ''}}</text>
        <text>只看直达</text>
      </view>
      <view class="fchip {{filters.daily ? 'fchip-on' : ''}}" bindtap="toggleDaily">
        <text class="fchip-box">{{filters.daily ? '✓' : ''}}</text>
        <text>天天发车</text>
      </view>
      <view class="fchip fchip-more {{agingIndex > 0 ? 'fchip-on' : ''}}" bindtap="pickAging">
        <text>{{agingOptions[agingIndex]}}</text>
        <text class="fchip-caret">▾</text>
      </view>
    </view>

    <view class="query-btn {{canQuery ? '' : 'query-btn-disabled'}}" bindtap="onQuery">查询专线</view>

    <!-- 空态：还没选地址时的引导 -->
    <view class="empty-card" wx:if="{{!fromText && !toText}}">
      <view class="empty-title">选择出发地和目的地</view>
      <view class="empty-sub">即可查看跑这条线的所有物流公司</view>
    </view>

    <!-- 已选好地址：给一个明确的"下一步"暗示 -->
    <view class="ready-card" wx:elif="{{fromText && toText}}">
      <view class="ready-route">{{fromText}} → {{toText}}</view>
      <view class="ready-sub">将按出发城市与到达城市匹配直达线路，<br/>未找到直达时会给出中转方案</view>
    </view>
    <view class="ready-card" wx:else>
      <view class="ready-route">{{fromText || '待选择'}} → {{toText || '待选择'}}</view>
      <view class="ready-sub">再选择{{fromText ? '目的地' : '出发地'}}即可查询</view>
    </view>

    <view class="home-btn" bindtap="goHome">⌂　返回首页</view>
  </view>

  <!-- 地区选择半屏弹层 -->
  <region-picker
    show="{{pickerShow}}"
    title="{{pickerTitle}}"
    value="{{pickerValue}}"
    bindchange="onRegionChange"
    bindconfirm="onRegionConfirm"
    bindcancel="onRegionCancel"
  />
</view>
