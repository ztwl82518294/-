<view class="page">
  <view class="fav-header">我的收藏</view>

  <view class="fav-main">
    <block wx:if="{{favoriteList.length>0}}">
      <view wx:for="{{favoriteList}}" wx:key="id" class="line-card" bindtap="goToDetail" data-line-id="{{item.id}}">
        <view class="line-header">
          <view class="line-title">{{item.title}}</view>
          <view class="line-badges">
            <view class="vip-badge-shine" wx:if="{{item.isVip}}"><text class="vip-icon-shine">👑</text><text>会员</text></view>
            <view class="cert-badge" wx:if="{{item.certified}}">已认证</view>
          </view>
        </view>
        <view class="line-route">{{item.fromCityName}} → {{item.toCityName}}</view>
        <view class="line-company {{item.isVip ? 'vip-company-shine' : ''}}">{{item.companyName}}</view>
        <view class="fav-cancel" catchtap="cancelFavorite" data-line-id="{{item.id}}">取消收藏</view>
      </view>
    </block>

    <!-- 读取失败：与"暂无收藏"区分，避免用户以为收藏丢失 -->
    <block wx:elif="{{loadError}}">
      <view class="empty-card">
        <view class="empty-title error">⚠️ 收藏加载失败</view>
        <view class="empty-desc">未能读取云端收藏，请检查网络后重试</view>
        <view class="retry-btn" bindtap="loadFavorites">重新加载</view>
      </view>
    </block>

    <block wx:else>
      <view class="empty-card">
        <view class="empty-title">暂无收藏</view>
        <view class="empty-desc">去首页查询并收藏你感兴趣的专线吧</view>
      </view>
    </block>
  </view>
</view>