.page{min-height:100vh;background:var(--bg-page);}
.fav-header{background:linear-gradient(135deg,var(--brand),var(--brand-light));padding:40rpx 30rpx 60rpx;border-radius:0 0 44rpx 44rpx;color:#fff;font-size:40rpx;font-weight:bold;}
.fav-main{padding:0 24rpx 40rpx;margin-top:-30rpx;}

.line-card{background:#fff;border-radius:24rpx;padding:26rpx;margin-bottom:24rpx;box-shadow:0 8rpx 24rpx rgba(31,45,61,.06);position:relative;}
.line-card:active{background:#f9fafb;}
/* 右上角"取消收藏"是绝对定位，标题行必须留出它的宽度，否则徽章会被压在下面 */
.line-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx;padding-right:130rpx;}
.line-title{font-size:32rpx;font-weight:bold;color:var(--ink-title);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.line-route{font-size:28rpx;color:#334155;margin-bottom:8rpx;}
.line-company{font-size:26rpx;color:#64748b;}
.fav-cancel{position:absolute;top:26rpx;right:26rpx;font-size:22rpx;color:#ef4444;background:#fee2e2;padding:6rpx 16rpx;border-radius:16rpx;}

.line-badges{display:flex;align-items:center;gap:10rpx;}
/* 会员徽章样式统一在 app.wxss 的 vip-badge-shine 定义 */
.cert-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:20rpx;background:var(--brand-wash);color:var(--brand-deep);font-size:20rpx;font-weight:bold;}

.empty-card{background:#fff;border-radius:24rpx;text-align:center;padding:60rpx 24rpx;}
.empty-title{font-size:32rpx;font-weight:bold;color:var(--ink-title);margin-bottom:12rpx;}
.empty-title.error{color:#dc2626;}
.empty-desc{font-size:26rpx;color:var(--ink-muted);}
/* 错误态重试按钮（与 line-list 保持同一套视觉） */
.retry-btn{
  margin:32rpx auto 0;
  width:260rpx;
  height:72rpx;
  line-height:72rpx;
  border-radius:36rpx;
  background:linear-gradient(135deg,var(--brand),var(--brand-light));
  color:#fff;
  font-size:28rpx;
  font-weight:bold;
  box-shadow:0 8rpx 20rpx rgba(37,99,235,.25);
}
.retry-btn:active{opacity:.85;}