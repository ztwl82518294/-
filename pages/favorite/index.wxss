.page{min-height:100vh;background:transparent;}

/* ===== 顶部渐变标题区（macOS 天气风） ===== */
.fav-header{
  background:linear-gradient(158deg, #6357cf 0%, #7d72dd 42%, #9a91e8 78%, #b4adf0 100%);
  padding:48rpx 32rpx 100rpx;
  border-radius:0 0 40rpx 40rpx;
  color:#fff;font-size:42rpx;font-weight:600;letter-spacing:-.4rpx;
  position:relative;overflow:hidden;
  text-shadow:0 2rpx 12rpx rgba(50,40,110,.18);
}
.fav-header::before{
  content:'';position:absolute;top:-40%;left:-10%;
  width:80%;height:120%;
  background:radial-gradient(ellipse at center, rgba(255,255,255,.96) 0%, transparent 68%);
  pointer-events:none;
}
.fav-main{padding:0 28rpx 60rpx;margin-top:-60rpx;position:relative;z-index:2;}

/* 卡片：实心白 */
.line-card{
  background:#ffffff;
  border:1rpx solid #ffffff;
  border-radius:24rpx;padding:26rpx;margin-bottom:18rpx;
  box-shadow:var(--shadow-card);position:relative;
}
.line-card:active{background:#ffffff;}
/* 右上角"取消收藏"是绝对定位，标题行必须留出它的宽度 */
.line-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx;padding-right:130rpx;}
.line-title{font-size:32rpx;font-weight:600;color:var(--ink-title);flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.2rpx;}
.line-route{font-size:28rpx;color:var(--ink-body);margin-bottom:8rpx;}
.line-company{font-size:26rpx;color:var(--ink-muted);}
/* 取消收藏：淡红胶囊 */
.fav-cancel{
  position:absolute;top:26rpx;right:26rpx;font-size:22rpx;
  color:#c4554d;
  background:rgba(252,235,235,.85);
  border:1rpx solid #ffffff;
  padding:6rpx 16rpx;border-radius:12rpx;
}

.line-badges{display:flex;align-items:center;gap:10rpx;}
/* 会员徽章样式统一在 app.wxss 的 vip-badge-shine 定义 */
.cert-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:10rpx;background:rgba(35,131,226,.1);color:var(--brand-deep);font-size:20rpx;font-weight:600;}

.empty-card{
  background:#ffffff;
  border:1rpx solid #ffffff;
  border-radius:24rpx;text-align:center;padding:60rpx 24rpx;
  box-shadow:var(--shadow-card);
}
.empty-title{font-size:32rpx;font-weight:600;color:var(--ink-title);margin-bottom:12rpx;}
.empty-title.error{color:#c4554d;}
.empty-desc{font-size:26rpx;color:var(--ink-muted);}
/* 错误态重试按钮（与 line-list 保持同一套视觉） */
.retry-btn{
  margin:32rpx auto 0;
  width:260rpx;height:76rpx;line-height:76rpx;
  border-radius:20rpx;
  background:linear-gradient(135deg,#3f96ea,#2383e2);
  color:#fff;font-size:28rpx;font-weight:600;
  box-shadow:0 8rpx 22rpx rgba(35,131,226,.3);
}
.retry-btn:active{opacity:.9;}
