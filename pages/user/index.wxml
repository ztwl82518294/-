<view class="page">
  <!-- 头部 -->
  <view class="user-hero">
    <view class="avatar">🚚</view>
    <view class="user-name">物流用户</view>
    <view class="user-sub" wx:if="{{isAdmin}}">管理员账号</view>
  </view>

  <view class="user-main">
    <!-- 管理入口 -->
    <view class="card admin-card" wx:if="{{isAdmin}}" bindtap="goToAdmin">
      <view class="admin-title">🛠 管理后台</view>
      <view class="admin-desc">点击进入，管理专线与广告</view>
    </view>

    <!-- 功能菜单 -->
    <view class="card menu-card">
      <view class="menu-item" bindtap="goContact"><text>🎧 联系客服</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goReport"><text>信息纠错</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goToFavorite"><text>我的收藏</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goAgreement" data-type="service"><text>用户服务协议</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goAgreement" data-type="disclaimer"><text>免责声明</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goAgreement" data-type="privacy"><text>隐私政策</text><text class="arrow">›</text></view>
    </view>

    <!-- 查询历史 -->
    <view class="card section-card">
      <view class="section-header">
        <text class="section-title">查询历史</text>
        <text class="clear-btn" wx:if="{{historyList.length>0}}" bindtap="clearHistory">清空</text>
      </view>
      <block wx:if="{{historyList.length>0}}">
        <view wx:for="{{historyList}}" wx:key="index" class="history-item" bindtap="reQuery" data-item="{{item}}">
          <view class="history-route">{{item.fromCityName}} → {{item.toCityName}}</view>
          <view class="history-time">{{item.time}}</view>
        </view>
      </block>
      <block wx:else><view class="empty-tip">暂无查询记录</view></block>
    </view>
  </view>
</view>