.page{min-height:100vh;background:var(--bg-page);}
.user-hero{background:linear-gradient(135deg,var(--brand),var(--brand-light));padding:60rpx 30rpx 80rpx;border-radius:0 0 44rpx 44rpx;display:flex;flex-direction:column;align-items:center;}
.avatar{width:120rpx;height:120rpx;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:60rpx;}
.user-name{color:#fff;font-size:36rpx;font-weight:bold;margin-top:16rpx;}
.user-sub{color:rgba(255,255,255,.85);font-size:24rpx;margin-top:6rpx;}
.user-main{padding:0 24rpx 40rpx;margin-top:-40rpx;}

.card{background:#fff;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(31,45,61,.06);}

.admin-card{background:linear-gradient(135deg,#7c3aed,#a855f7);color:#fff;padding:30rpx 24rpx;margin-bottom:24rpx;}
.admin-title{font-size:32rpx;font-weight:bold;margin-bottom:8rpx;}
.admin-desc{font-size:24rpx;opacity:.9;}

.menu-card{padding:0 24rpx;margin-bottom:24rpx;}
.menu-item{display:flex;justify-content:space-between;align-items:center;padding:28rpx 0;border-bottom:1rpx solid #f1f5f9;font-size:28rpx;color:#334155;}
.menu-item:last-child{border-bottom:none;}
.arrow{font-size:32rpx;color:var(--ink-muted);}

.section-card{padding:28rpx;margin-bottom:24rpx;}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;}
.section-title{font-size:30rpx;font-weight:bold;color:var(--ink-title);}
.clear-btn{font-size:24rpx;color:#ef4444;}

.history-item{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f1f5f9;}
.history-item:last-child{border-bottom:none;}
.history-route{font-size:28rpx;color:#334155;font-weight:bold;}
.history-time{font-size:22rpx;color:var(--ink-muted);}

.empty-tip{text-align:center;padding:30rpx 0;color:var(--ink-muted);font-size:26rpx;}