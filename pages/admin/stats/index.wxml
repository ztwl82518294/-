<!-- 月度访问用户统计排名（仅管理员可见） -->
<view class="page">

  <!-- 月份切换 -->
  <view class="month-bar">
    <view class="month-arrow" bindtap="prevMonth">‹</view>
    <view class="month-label">{{label}}</view>
    <view class="month-arrow {{isCurrent ? 'disabled' : ''}}" bindtap="nextMonth">›</view>
  </view>

  <!-- 汇总卡片 -->
  <view class="summary-row">
    <view class="summary-card c-user">
      <view class="summary-num">{{usersText}}</view>
      <view class="summary-label">活跃用户</view>
    </view>
    <view class="summary-card c-search">
      <view class="summary-num">{{totals.search}}</view>
      <view class="summary-label">搜索次数</view>
    </view>
    <view class="summary-card c-view">
      <view class="summary-num">{{totals.view}}</view>
      <view class="summary-label">浏览次数</view>
    </view>
  </view>

  <!-- 达到聚合上限时的口径说明：数字是下限，不是精确值 -->
  <view class="cap-tip" wx:if="{{totals.usersCapped}}">
    ⚠️ 活跃用户已达统计上限 {{totals.users}}，实际人数更多（云开发聚合单次最多返回 1000 条，此处为下限值）
  </view>

  <block wx:if="{{loading}}">
    <view class="loading-tip">统计加载中...</view>
  </block>

  <block wx:else>
    <!-- 活跃用户排名 -->
    <view class="card rank-card">
      <view class="rank-title">👥 活跃用户排行 Top{{users.length || ''}}</view>
      <block wx:if="{{users.length}}">
        <view class="rank-item" wx:for="{{users}}" wx:key="openid">
          <view class="rank-no rank-{{index < 3 ? index + 1 : 'n'}}">{{index + 1}}</view>
          <view class="rank-main">
            <view class="rank-name">{{item.openidMask}}</view>
            <view class="rank-sub">最后活跃 {{item.lastTime}}</view>
          </view>
          <view class="rank-stats">
            <view class="rank-total">{{item.total}} 次</view>
            <view class="rank-detail">搜{{item.search}} · 览{{item.view}}</view>
          </view>
          <view class="award-btn" catchtap="assignPrize" data-openid="{{item.openid}}">发奖</view>
        </view>
      </block>
      <view class="empty" wx:else>本月暂无访问记录</view>
    </view>
  </block>

</view>
