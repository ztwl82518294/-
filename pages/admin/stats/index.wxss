/* pages/admin/stats/index.wxss */
.page {
  min-height: 100vh;
  background: transparent;
  padding-bottom: 40rpx;
}

/* 月份切换 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 8rpx;
}
.month-arrow {
  width: 68rpx;
  height: 68rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--brand);
  background: #ffffff;
  border: 1rpx solid #ffffff;
  border-radius: 20rpx;
  margin: 0 40rpx;
  box-shadow: var(--shadow-card);
}
.month-arrow.disabled {
  color: var(--ink-disabled);
  pointer-events: none;
}
.month-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink-title);
  min-width: 180rpx;
  text-align: center;
  letter-spacing: -.3rpx;
}

/* ===== 汇总卡片：白底 + 天气色渐变 ===== */
.summary-row {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.summary-card {
  flex: 1;
  border-radius: 24rpx;
  padding: 28rpx 0;
  text-align: center;
  border: 1rpx solid #ffffff;
  box-shadow: var(--shadow-card);
}
.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -.8rpx;
}
.summary-label {
  font-size: 22rpx;
  margin-top: 6rpx;
  opacity: .8;
}
/* 三张卡各挂一套天气色（蓝 / 琥珀 / 绿），文字用对应深色保证可读 */
.c-user   { background: var(--sky-blue); }
.c-user .summary-num   { color: var(--sky-blue-ink); }
.c-user .summary-label { color: var(--sky-blue-ink); }

.c-search { background: var(--sky-amber); }
.c-search .summary-num   { color: var(--sky-amber-ink); }
.c-search .summary-label { color: var(--sky-amber-ink); }

.c-view   { background: var(--sky-green); }
.c-view .summary-num   { color: var(--sky-green-ink); }
.c-view .summary-label { color: var(--sky-green-ink); }

/* 达到聚合上限时的口径提示（浅黄 callout） */
.cap-tip {
  margin: 0 28rpx 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(253, 248, 236, .9);
  border: 1rpx solid #ffffff;
  color: #8a6a1f;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 卡片基础样式（本页自包含） */
.card {
  background: #ffffff;
  border: 1rpx solid #ffffff;
  border-radius: 24rpx;
  box-shadow: var(--shadow-card);
}

/* 排名卡片 */
.rank-card {
  margin: 20rpx 28rpx 0;
  padding: 28rpx 24rpx;
}
.rank-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-title);
  margin-bottom: 12rpx;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid rgba(120, 140, 170, .14);
}
.rank-item:last-child {
  border-bottom: none;
}
/* 名次编号：底色方块 */
.rank-no {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-muted);
  background: rgba(255,255,255,.98);
  border: 1rpx solid #ffffff;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rank-1 { background: var(--sky-amber); color: var(--sky-amber-ink); }
.rank-2 { background: rgba(240, 242, 246, .95); color: #5f5e5b; }
.rank-3 { background: linear-gradient(135deg, #fdf3e3 0%, #f7e6cf 100%); color: #a06a12; }
.rank-main {
  flex: 1;
  min-width: 0;
}
.rank-name {
  font-size: 28rpx;
  color: var(--ink-title);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-sub {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 4rpx;
}
.rank-stats {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.rank-total {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 700;
}
.rank-detail {
  font-size: 20rpx;
  color: var(--ink-muted);
  margin-top: 4rpx;
}
.empty {
  text-align: center;
  color: var(--ink-muted);
  font-size: 26rpx;
  padding: 40rpx 0;
}
.loading-tip {
  text-align: center;
  color: var(--ink-muted);
  font-size: 26rpx;
  padding: 80rpx 0;
}
