/* pages/admin/stats/index.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* 月份切换 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0 8rpx;
}
.month-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 44rpx;
  color: var(--brand);
  background: #fff;
  border-radius: 50%;
  margin: 0 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, .1);
}
.month-arrow.disabled {
  color: var(--ink-disabled);
  pointer-events: none;
}
.month-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink-title);
  min-width: 180rpx;
  text-align: center;
}

/* 汇总卡片 */
.summary-row {
  display: flex;
  gap: 18rpx;
  padding: 24rpx 32rpx;
}
.summary-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  color: #fff;
}
.c-user { background: linear-gradient(135deg, var(--brand), var(--brand-light)); }
.c-search { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
.c-view { background: linear-gradient(135deg, #10b981, #34d399); }
.summary-num {
  font-size: 44rpx;
  font-weight: 800;
}
.summary-label {
  font-size: 22rpx;
  opacity: .9;
  margin-top: 6rpx;
}

/* 达到聚合上限时的口径提示 */
.cap-tip {
  margin: 0 32rpx 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  border-left: 6rpx solid #f59e0b;
  color: #92400e;
  font-size: 24rpx;
  line-height: 1.5;
}

/* 卡片基础样式（本页自包含） */
.card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 45, 61, .06);
}

/* 排名卡片 */
.rank-card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 24rpx;
}
.rank-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-title);
  margin-bottom: 12rpx;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.rank-item:last-child {
  border-bottom: none;
}
.rank-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-muted);
  background: #f1f5f9;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.rank-1 { background: #fef3c7; color: #d97706; }
.rank-2 { background: #e2e8f0; color: #475569; }
.rank-3 { background: #fed7aa; color: #ea580c; }
.rank-main {
  flex: 1;
  min-width: 0;
}
.rank-name {
  font-size: 28rpx;
  color: var(--ink-title);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-sub {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 4rpx;
}
.rank-stats {
  text-align: right;
  margin-left: 16rpx;
  flex-shrink: 0;
}
.rank-total {
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 700;
}
.rank-detail {
  font-size: 20rpx;
  color: var(--ink-muted);
  margin-top: 4rpx;
}
.empty {
  text-align: center;
  color: var(--ink-muted);
  font-size: 26rpx;
  padding: 40rpx 0;
}
.loading-tip {
  text-align: center;
  color: var(--ink-muted);
  font-size: 26rpx;
  padding: 80rpx 0;
}
