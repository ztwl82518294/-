/* 后台管理 · 总览
 *
 * 遵守全站 Notion 浅色主题五条铁律：
 *   无渐变 / 无光斑 / 无半透明染色 / 无高光内阴影 / 字体无毛玻璃。
 * 分层仍只有两层：页面底 #F7F6F3（.page）+ 纯白卡片（.card）。
 */

.note-desc {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--color-text-secondary);
}

/* openid 展示块：等宽感的浅底，方便人工核对与长按复制 */
.openid-box {
  margin-top: var(--gap-md);
  padding: var(--gap-sm) var(--gap-md);
  background-color: var(--color-bg-sunken);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.openid {
  font-size: 26rpx;
  color: var(--color-text-primary);
  word-break: break-all;
  line-height: 1.7;
}

.act-row {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  margin-top: var(--gap-md);
}

.btn-sm--ghost {
  background-color: var(--color-bg-card);
  color: var(--color-primary);
  border: 1rpx solid var(--edge-blue);
}

.btn-sm--ghost:active {
  background-color: var(--color-bg-hover);
}

/* ============================================================
 * 数据规模
 * ============================================================ */

.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat {
  width: 33.33%;
  padding: var(--gap-sm) 0;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink-blue);
}

.stat-label {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
 * 上线门槛
 * ============================================================ */

.gate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--gap-sm) 0;
}

.gate-row + .gate-row {
  border-top: 1rpx solid var(--color-border);
}

.gate-name {
  font-size: 27rpx;
  color: var(--color-text-secondary);
}

.gate-val {
  font-size: 30rpx;
  font-weight: 600;
}

/* 铁律 3：全实色，不用 rgba 文字色 */
.gate-val--ok { color: var(--ink-green); }
.gate-val--bad { color: var(--color-danger); }

/* ============================================================
 * 入口九宫格
 * ============================================================ */

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--gap-sm);
}

.entry {
  width: calc(50% - var(--gap-sm) / 2);
  padding: var(--gap-md);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.entry:active {
  background-color: var(--color-bg-hover);
}

.entry-label {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.entry-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
 * 冲突提醒
 * ============================================================ */

.warn {
  margin-top: var(--gap-md);
  padding: var(--gap-md);
  background-color: var(--tint-amber);
  border: 1rpx solid var(--edge-amber);
  border-radius: var(--radius-md);
}

.warn-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink-amber);
}

.warn-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-amber);
}
