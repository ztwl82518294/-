/* 后台管理 · 通用表单
 * 沿用全局 .field / .field-label / .field-input，这里只补多行块与提交按钮。
 */

.note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-sm);
  margin-bottom: var(--gap-md);
  padding: var(--gap-sm) var(--gap-md);
  background-color: var(--tint-blue);
  border: 1rpx solid var(--edge-blue);
  border-radius: var(--radius-md);
}

.note-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--ink-blue);
}

.note-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ink-blue);
}

/* ============================================================
 * 表单
 * ============================================================ */

/* .field 内部最后一项不画分隔线 */
.form .field:last-child {
  border-bottom: none;
}

.field-spacer {
  flex: 1;
}

.fld-star {
  color: var(--color-danger);
}

/* 多行输入块 */
.fld-block {
  padding: var(--gap-md);
  border-bottom: 1rpx solid var(--color-border);
}

.fld-label {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: var(--gap-sm);
}

.fld-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
}

.fld-hint {
  margin-top: var(--gap-xs);
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--color-text-tertiary);
}

/* ============================================================
 * 提交
 * ============================================================ */

.foot-btn {
  margin-top: var(--gap-md);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  border-radius: var(--radius-md);
}

.foot-btn:active {
  background-color: var(--color-primary-dark);
}

.foot-btn--disabled {
  background-color: var(--color-bg-sunken);
  color: var(--color-text-tertiary);
}

.save-note {
  margin-top: var(--gap-sm);
  text-align: center;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}
