<!-- 奖品发放（管理员） -->
<view class="page">

  <!-- 核销区 -->
  <view class="card verify-card">
    <view class="verify-title">🎟️ 兑奖码核销</view>
    <view class="verify-row">
      <input class="verify-input" placeholder="输入用户报来的兑奖码" value="{{verifyCode}}" bindinput="onCodeInput" />
      <button class="verify-btn" bindtap="verify">核销</button>
    </view>
  </view>

  <!-- 月份切换 -->
  <view class="month-bar">
    <view class="month-arrow" bindtap="prevMonth">‹</view>
    <view class="month-label">{{label}}</view>
    <view class="month-arrow {{isCurrent ? 'disabled' : ''}}" bindtap="nextMonth">›</view>
  </view>

  <!-- 生成按钮 -->
  <view class="gen-wrap">
    <button class="gen-btn" bindtap="generate">🏆 生成前 5 名兑奖码</button>
  </view>

  <!-- 名单 -->
  <view class="card list-card">
    <block wx:if="{{list.length}}">
      <view class="code-item" wx:for="{{list}}" wx:key="_id">
        <view class="code-line">
          <view class="rank-no {{item.manual ? 'rank-manual' : ('rank-' + (index < 3 ? index + 1 : 'n'))}}">{{item.manual ? '特' : item.rank}}</view>
          <view class="code-main" bindtap="copyCode" data-code="{{item.code}}">
            <view class="code-text">{{item.code}}</view>
            <view class="code-sub">{{item.openidMask}}</view>
          </view>
          <view class="code-status {{item.shipped ? 'st-ship' : (item.claimed ? 'st-claim' : 'st-wait')}}">
            {{item.shipped ? '已发放' : (item.claimed ? '已核销·待发放' : '未核销')}}
          </view>
        </view>
        <!-- 操作按钮：固定 handler，data-op 分支 -->
        <view class="code-actions">
          <view wx:if="{{!item.claimed}}" class="act act-primary" catchtap="onItemAction" data-op="claim" data-id="{{item._id}}">核销</view>
          <view wx:if="{{item.claimed && !item.shipped}}" class="act act-primary" catchtap="onItemAction" data-op="ship" data-id="{{item._id}}">标记发放</view>
          <view wx:if="{{item.shipped}}" class="act act-plain" catchtap="onItemAction" data-op="unship" data-id="{{item._id}}">撤销发放</view>
          <view wx:if="{{item.claimed && !item.shipped}}" class="act act-plain" catchtap="onItemAction" data-op="unclaim" data-id="{{item._id}}">撤销核销</view>
          <view class="act act-danger" catchtap="onItemAction" data-op="remove" data-id="{{item._id}}">作废</view>
        </view>
      </view>
    </block>
    <view class="empty" wx:else>{{loading ? '加载中...' : '该月份尚未生成兑奖码'}}</view>
  </view>

  <!-- 操作日志 -->
  <view class="card log-card">
    <view class="log-header" bindtap="toggleLogs">
      <view class="log-title">📋 操作日志（{{label}}）</view>
      <view class="log-arrow">{{showLogs ? '收起 ▲' : '展开 ▼'}}</view>
    </view>
    <block wx:if="{{showLogs}}">
      <block wx:if="{{logs.length}}">
        <view class="log-item" wx:for="{{logs}}" wx:key="_id">
          <view class="log-time">{{item.timeText}}</view>
          <view class="log-tag {{item.meta.cls}}">{{item.meta.tag}}</view>
          <view class="log-desc">{{item.desc}}</view>
          <view class="log-actor">操作人 {{item.actorMask}}</view>
        </view>
      </block>
      <view class="empty" wx:else>本月暂无操作记录</view>
    </block>
  </view>

</view>
