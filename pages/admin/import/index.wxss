/* 后台管理 · 批量导入 */

.csv-area {
  width: 100%;
  min-height: 320rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
}

.tmpl-row {
  display: flex;
  align-items: center;
  gap: var(--gap-sm);
  margin-top: var(--gap-sm);
  padding-top: var(--gap-sm);
  border-top: 1rpx solid var(--color-border);
}

.tmpl-link {
  font-size: 25rpx;
  color: var(--color-primary);
}

.tmpl-sep {
  font-size: 25rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
 * 数字概览
 * ============================================================ */

.sum-grid {
  display: flex;
  flex-wrap: wrap;
}

.sum {
  width: 25%;
  padding: var(--gap-sm) 0;
  text-align: center;
}

.sum-num {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink-blue);
}

/* 铁律 3 / 5：全实色，不用 rgba 文字色 */
.sum-num--ok { color: var(--ink-green); }
.sum-num--bad { color: var(--color-danger); }

.sum-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.sum-line {
  margin-top: var(--gap-sm);
  padding-top: var(--gap-sm);
  border-top: 1rpx solid var(--color-border);
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}

/* ============================================================
 * 错误行
 * ============================================================ */

.err-row {
  display: flex;
  align-items: flex-start;
  gap: var(--gap-sm);
  padding: var(--gap-sm) 0;
}

.err-row + .err-row {
  border-top: 1rpx solid var(--color-border);
}

.err-line {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--ink-amber);
}

.err-msg {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
  word-break: break-all;
}

.err-more {
  margin-top: var(--gap-sm);
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}

/* ============================================================
 * 按钮
 * ============================================================ */

.foot-btn {
  margin-top: var(--gap-md);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  border-radius: var(--radius-md);
}

.foot-btn:active {
  background-color: var(--color-primary-dark);
}

.foot-btn--disabled {
  background-color: var(--color-bg-sunken);
  color: var(--color-text-tertiary);
}

.foot-btn--ghost {
  margin-top: var(--gap-sm);
  color: var(--color-primary);
  background-color: var(--color-bg-card);
  border: 1rpx solid var(--edge-blue);
}

.foot-btn--ghost:active {
  background-color: var(--color-bg-hover);
}

.save-note {
  margin-top: var(--gap-sm);
  text-align: center;
  font-size: 23rpx;
  color: var(--color-text-tertiary);
}
