/* 广告位编辑：渐变头 + 分区块表单 + 专线选择弹层 */
.page {
  min-height: 100vh;
  background: transparent;
  padding-bottom: 60rpx;
}

/* ===== 渐变头图 ===== */
.hero {
  padding: 40rpx 40rpx 96rpx;
  background: linear-gradient(158deg, #3d7fd4 0%, #5b9ce4 42%, #8dbcee 78%, #a8cdf2 100%);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  left: -20%;
  top: -40%;
  width: 140%;
  height: 140%;
  background: radial-gradient(ellipse at center, rgba(255,255,255,.96) 0%, transparent 68%);
}
.hero-inner { position: relative; z-index: 1; }
.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 500;
  color: #2c5f96;
  background: rgba(255,255,255,.96);
  border: 1rpx solid rgba(255,255,255,.96);
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
  margin-top: 18rpx;
  letter-spacing: -.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,.92);
  margin-top: 10rpx;
}

/* ===== 内容上叠 ===== */
.main {
  padding: 0 28rpx;
  margin-top: -68rpx;
  position: relative;
  z-index: 2;
}

/* ===== 表单卡片 ===== */
.form-card {
  background: var(--glass);
  border: 1rpx solid var(--glass-border);
  border-radius: 22rpx;
  box-shadow: var(--shadow-card);
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}
.form-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}
.form-head-title {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brand-deep);
  letter-spacing: .5rpx;
}
.form-head-hint { font-size: 22rpx; color: var(--ink-muted); }

/* 字段：标签在上、输入在下，比原来的左右布局更好读 */
.field {
  padding: 18rpx 0 22rpx;
  border-bottom: 1rpx solid rgba(120, 140, 170, .14);
}
.field-last { border-bottom: none; }
.field-label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}
.field-input {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid rgba(120, 140, 170, .2);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: var(--ink-title);
}
.field-input-num { letter-spacing: 1rpx; }
.field-ph { color: var(--ink-disabled); }
.field-tip {
  display: block;
  font-size: 20rpx;
  color: var(--ink-muted);
  margin-top: 10rpx;
  line-height: 1.5;
}

/* ===== 跳转专线选择行 ===== */
.line-pick {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0 24rpx;
}
.line-pick-body { flex: 1; min-width: 0; }
.line-pick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-title);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.line-pick-title.is-ph { font-weight: 400; color: var(--ink-muted); }
.line-pick-sub {
  display: block;
  font-size: 21rpx;
  color: var(--ink-muted);
  margin-top: 6rpx;
}
.line-pick-action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brand);
  background: var(--brand-wash);
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
}
.line-clear {
  font-size: 24rpx;
  color: #a32d2d;
  text-align: center;
  padding: 0 0 24rpx;
}

.save-btn { margin-top: 8rpx; }

.foot-note {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: var(--ink-muted);
  line-height: 1.6;
  text-align: center;
}

/* ===== 专线选择弹层 ===== */
.picker-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(20, 30, 50, .4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.picker-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid #ffffff;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.picker-grabber {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(120, 140, 170, .3);
  margin: 0 auto 20rpx;
}
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.picker-title { font-size: 30rpx; font-weight: 600; color: var(--ink-title); }
.picker-close { color: var(--ink-muted); font-size: 32rpx; padding: 8rpx 0 8rpx 20rpx; }

.picker-search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid rgba(120, 140, 170, .2);
  border-radius: 16rpx;
  padding: 0 20rpx;
  margin-bottom: 14rpx;
}
.picker-search-icon { font-size: 26rpx; opacity: .5; }
.picker-search {
  flex: 1;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--ink-title);
}
.picker-search-clear {
  font-size: 26rpx;
  color: var(--ink-muted);
  padding: 8rpx 0 8rpx 12rpx;
}

.picker-list { flex: 1; overflow-y: auto; max-height: 50vh; }
.picker-tip {
  text-align: center;
  color: var(--ink-muted);
  font-size: 26rpx;
  padding: 48rpx 0;
  line-height: 1.6;
}
.picker-item {
  padding: 22rpx 8rpx;
  border-bottom: 1rpx solid rgba(120, 140, 170, .14);
}
.picker-item-title {
  font-size: 28rpx;
  color: var(--ink-title);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker-item-sub {
  font-size: 23rpx;
  color: var(--ink-muted);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
