<view class="container">

  <view class="card form-card">
    <view class="form-item"><text class="form-label">专线名称*</text><input class="form-input" placeholder="如：济南-重庆 专线" value="{{form.title}}" bindinput="onInput" data-field="title"/></view>
    <view class="form-item"><text class="form-label">公司名称</text><input class="form-input" value="{{form.companyName}}" bindinput="onInput" data-field="companyName"/></view>

    <!-- 城市：支持"手输 + 级联选择"。级联只到区县级，而专线目的地常写到乡镇
         （如"羊流镇"），只给 picker 会导致这类线路在管理端无法录入、也无法修改 -->
    <view class="form-item">
      <text class="form-label">出发城市*</text>
      <input class="form-input" placeholder="手输或用右侧选择" value="{{form.fromCityName}}" bindinput="onCityInput" data-field="fromCityName"/>
      <picker mode="region" value="{{fromRegion}}" bindchange="onFromCity">
        <view class="pick-btn">选择</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">目的城市*</text>
      <input class="form-input" placeholder="手输或用右侧选择" value="{{form.toCityName}}" bindinput="onCityInput" data-field="toCityName"/>
      <picker mode="region" value="{{toRegion}}" bindchange="onToCity">
        <view class="pick-btn">选择</view>
      </picker>
    </view>

    <view class="form-item form-item-area"><text class="form-label">发货地址</text><textarea class="form-input form-textarea" maxlength="-1" auto-height value="{{form.fromAddress}}" bindinput="onInput" data-field="fromAddress"/></view>

    <!-- 发货地址定位：选点后自动填发货地址，并显示选点名称便于核对 -->
    <view class="form-item">
      <text class="form-label">发货定位</text>
      <view class="loc-btn" bindtap="chooseLocation">
        {{form.latitude ? (locName ? '已定位：' + locName + '（点击重选）' : '已定位（点击重选）') : '点击地图选择发货地址'}}
      </view>
    </view>

    <view class="form-item form-item-area"><text class="form-label">到货地址</text><textarea class="form-input form-textarea" maxlength="-1" auto-height value="{{form.toAddress}}" bindinput="onInput" data-field="toAddress"/></view>

    <!-- 到货定位：收货方导航用，选点后自动填到货地址 -->
    <view class="form-item">
      <text class="form-label">到货定位</text>
      <view class="loc-btn" bindtap="chooseToLocation">
        {{form.toLatitude ? (toLocName ? '已定位：' + toLocName + '（点击重选）' : '已定位（点击重选）') : '点击地图选择到货地址（可选）'}}
      </view>
    </view>

    <view class="form-item form-item-area"><text class="form-label">辐射到达县区</text><textarea class="form-input form-textarea" maxlength="-1" auto-height placeholder="逗号分隔，如：万州区,涪陵区" value="{{form.toAreas}}" bindinput="onInput" data-field="toAreas"/></view>

    <view class="form-item"><text class="form-label">时效</text><input class="form-input" placeholder="如：2-3天" value="{{form.aging}}" bindinput="onInput" data-field="aging"/></view>
    <view class="form-item"><text class="form-label">价格</text><input class="form-input" placeholder="如：重货400元/吨，泡货100元/方" value="{{form.priceDesc}}" bindinput="onInput" data-field="priceDesc"/></view>
    <view class="form-item">
      <text class="form-label">类型</text>
      <picker range="{{lineTypeOptions}}" value="{{lineTypeIndex}}" bindchange="onLineType">
        <view class="form-input">{{lineTypeOptions[lineTypeIndex] || form.lineType || '直达'}}</view>
      </picker>
    </view>
    <!-- 电话必须用文本键盘：多号码含 / - 分隔符，数字键盘无法输入 -->
    <view class="form-item"><text class="form-label">发站电话*</text><input class="form-input" type="text" placeholder="发站联系电话，多个用 / 分隔" value="{{form.fromPhone}}" bindinput="onInput" data-field="fromPhone"/></view>
    <view class="form-item"><text class="form-label">到站电话</text><input class="form-input" type="text" placeholder="到站联系电话，与发站相同可不填" value="{{form.toPhone}}" bindinput="onInput" data-field="toPhone"/></view>
    <view class="form-item"><text class="form-label">标签</text><input class="form-input" placeholder="逗号分隔" value="{{form.tags}}" bindinput="onInput" data-field="tags"/></view>

    <!-- VIP 改为到期时间管理：isVip 由 vipExpireAt 派生，支持开通/续费/停用 -->
    <view class="form-item form-item-area">
      <text class="form-label">会员企业</text>
      <view class="vip-mgr">
        <view class="vip-status {{vipOn ? 'on' : ''}}">{{vipText}}</view>
        <view class="vip-actions">
          <view class="vip-btn" bindtap="onVipExtend" data-days="30">+1个月</view>
          <view class="vip-btn" bindtap="onVipExtend" data-days="365">+1年</view>
          <view class="vip-btn warn" bindtap="onVipClear">停用</view>
        </view>
      </view>
    </view>
    <view class="form-item"><text class="form-label">已认证</text><switch checked="{{form.certified===1}}" bindchange="onCert"/></view>
    <view class="form-item"><text class="form-label">是否上架</text><switch checked="{{form.status===1}}" bindchange="onStatus"/></view>
  </view>

</view>

<!-- 固定底栏保存：长表单无需滚到底即可保存 -->
<view class="save-bar">
  <view class="btn-primary" bindtap="save">保存</view>
</view>
