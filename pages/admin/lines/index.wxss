/* pages/admin/lines/index.wxss */

/* 搜索栏：实心白 */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #ffffff;
  border-radius: 18rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}
.search-input {
  flex: 1;
  height: 76rpx;
  font-size: 28rpx;
  color: var(--ink-title);
}
.search-clear {
  font-size: 28rpx;
  color: var(--ink-muted);
  padding: 0 8rpx 0 16rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
}

/* 导入/导出工具栏：白底按钮 */
.tool-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.tool-btn {
  flex: 1;
  text-align: center;
  background: #ffffff;
  color: var(--brand);
  border: 1rpx solid #ffffff;
  border-radius: 18rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
  box-shadow: var(--shadow-card);
}
.tool-btn:active {
  background: #ffffff;
}

/* 第一行：名称和状态 */
.line-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.line-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-body);
  flex: 1;
  margin-right: 12rpx;
}
.line-badges {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 状态标签：浅底小胶囊 */
.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 600;
}
.status.on {
  color: var(--sky-green-ink);
  background: rgba(233, 244, 230, .92);
}
.status.off {
  color: #c4554d;
  background: rgba(252, 235, 235, .92);
}

/* 第一行：公司名称（卡片主标题，字号最大） */
.line-company {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink-title);
  line-height: 1.3;
  margin: 0 0 10rpx;
  letter-spacing: -.3rpx;
}

/* 第三行路线 */
.line-sub {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin: 0 0 16rpx;
}

/* 操作按钮行 */
.op-row {
  display: flex;
  gap: 24rpx;
}
.op {
  font-size: 26rpx;
  color: var(--brand);
  padding: 8rpx 0;
}
.op.del {
  color: #c4554d;
}
/* VIP 到期状态文本 */
.vip-expire { color: var(--sky-amber-ink); font-size: 24rpx; }

/* 分页加载指示 */
.load-stat { text-align: center; padding: 8rpx 0; font-size: 24rpx; }
