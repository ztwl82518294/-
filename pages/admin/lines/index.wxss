/* pages/admin/lines/index.wxss */

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--ink-title);
}
.search-clear {
  font-size: 28rpx;
  color: var(--ink-muted);
  padding: 0 8rpx 0 16rpx;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
}

/* 导入/导出工具栏 */
.tool-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.tool-btn {
  flex: 1;
  text-align: center;
  background: #ffffff;
  color: var(--brand);
  border: 1rpx solid var(--brand);
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 18rpx 0;
}
.tool-btn:active {
  opacity: 0.85;
}

/* 第一行：名称和状态 */
.line-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.line-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #4b5563;
  flex: 1;
  margin-right: 12rpx;
}
.line-badges {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

/* 状态标签 */
.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.status.on {
  color: #059669;
  background: #d1fae5;
}
.status.off {
  color: #ef4444;
  background: #fee2e2;
}

/* 第一行：公司名称（卡片主标题，字号最大） */
.line-company {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--ink-title);
  line-height: 1.3;
  margin: 0 0 10rpx;
}

/* 第三行路线 */
.line-sub {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin: 0 0 16rpx;
}

/* 操作按钮行 */
.op-row {
  display: flex;
  gap: 24rpx;
}
.op {
  font-size: 26rpx;
  color: var(--brand);
  padding: 8rpx 0;
}
.op.del {
  color: #ef4444;
}
/* VIP 到期状态文本 */
.vip-expire { color: #d97706; font-size: 24rpx; }

/* 分页加载指示 */
.load-stat { text-align: center; padding: 8rpx 0; font-size: 24rpx; }
