/* pages/admin/line-edit/index.wxss */
.form-card { padding: 0; margin-bottom: 140rpx; }
.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(120, 140, 170, .14);
}
.form-item:last-child { border-bottom: none; }
.form-label {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--ink-body);
  flex-shrink: 0;
}
.form-input { flex: 1; font-size: 28rpx; }
/* 辐射到达县区：多行输入，内容不限、自动换行增高 */
.form-item-area { align-items: flex-start; }
.form-textarea {
  width: 100%;
  min-height: 72rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
/* ===== VIP 到期时间管理 ===== */
.vip-mgr { flex: 1; }
.vip-status {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}
.vip-status.on { color: var(--sky-amber-ink); font-weight: 600; }
.vip-actions { display: flex; gap: 16rpx; }
/* VIP 按钮：磨砂浅金 */
.vip-btn {
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
  background: rgba(253, 246, 227, .92);
  color: var(--sky-amber-ink);
  border: 1rpx solid rgba(255, 255, 255, .9);
}
/* 取消 VIP：中性磨砂 */
.vip-btn.warn {
  background: rgba(255,255,255,.9);
  color: var(--ink-muted);
  border-color: rgba(120, 140, 170, .2);
}

/* ===== 固定底栏保存（磨砂浮层） ===== */
.save-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.91);
  -webkit-backdrop-filter: blur(16rpx) saturate(150%);
  backdrop-filter: blur(16rpx) saturate(150%);
  border-top: 1rpx solid rgba(255, 255, 255, .9);
  box-shadow: 0 -6rpx 24rpx rgba(20, 40, 70, .08);
  z-index: 10;
}
.input-placeholder { color: var(--ink-disabled); }

/* ===== 城市手输 + 级联选择 ===== */
.pick-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: var(--brand);
  background: rgba(35, 131, 226, .1);
  border: 1rpx solid rgba(255, 255, 255, .9);
  border-radius: 14rpx;
}
