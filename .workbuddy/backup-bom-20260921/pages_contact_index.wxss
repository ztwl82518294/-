/* pages/contact/index.wxss */
.page {
  min-height: 100vh;
  background: transparent;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}
.header {
  padding: 32rpx 4rpx 24rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink-title);
  letter-spacing: -.4rpx;
}
.header-sub {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin-top: 12rpx;
  line-height: 1.5;
}

/* 联系方式条目：磨砂玻璃 */
.contact-item {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,.88);
  -webkit-backdrop-filter: blur(16rpx) saturate(150%);
  backdrop-filter: blur(16rpx) saturate(150%);
  border: 1rpx solid rgba(255,255,255,.96);
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-card);
  text-align: left;
  line-height: normal;
}
.contact-item::after { border: none; }
.contact-item:active { background: rgba(255,255,255,.96); }
/* 在线客服：主色磨砂块 */
.online {
  background: linear-gradient(135deg, #3f96ea 0%, #2383e2 100%);
  border-color: rgba(255, 255, 255, .3);
  box-shadow: 0 8rpx 24rpx rgba(35, 131, 226, .3);
}
.online .ci-name { color: #fff; }
.online .ci-desc { color: rgba(255, 255, 255, .88); }
.online .ci-arrow { color: #fff; }
.ci-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(35, 131, 226, .1);
  border: 1rpx solid rgba(255, 255, 255, .85);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.online .ci-icon { background: rgba(255, 255, 255, .22); border-color: rgba(255, 255, 255, .4); }
.ci-main { flex: 1; min-width: 0; }
.ci-name { font-size: 30rpx; font-weight: 600; color: var(--ink-title); }
.ci-desc { font-size: 24rpx; color: var(--ink-muted); margin-top: 8rpx; }
.ci-arrow { font-size: 36rpx; color: var(--ink-disabled); }
.ci-action {
  font-size: 24rpx;
  color: var(--brand);
  background: rgba(35, 131, 226, .1);
  border: 1rpx solid rgba(255, 255, 255, .85);
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

/* 二维码卡片 */
.qr-card {
  background: rgba(255,255,255,.88);
  -webkit-backdrop-filter: blur(16rpx) saturate(150%);
  backdrop-filter: blur(16rpx) saturate(150%);
  border: 1rpx solid rgba(255,255,255,.96);
  border-radius: 24rpx;
  padding: 40rpx 28rpx;
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-card);
}
.qr-img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 16rpx;
}
.qr-tip {
  font-size: 26rpx;
  color: var(--ink-muted);
  margin-top: 24rpx;
}
.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 48rpx;
  padding: 0 40rpx;
  line-height: 1.6;
}
