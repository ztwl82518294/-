.page{min-height:100vh;background:transparent;}

/* ===== 详情页头部（macOS 天气：渐变天空 + 白色文字） ===== */
.hero{
  background:linear-gradient(158deg, #3d7fd4 0%, #5b9ce4 42%, #8dbcee 78%, #a8cdf2 100%);
  padding:48rpx 32rpx 104rpx;
  border-radius:0 0 40rpx 40rpx;
  position:relative;text-align:left;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:-40%;left:-10%;
  width:80%;height:120%;
  background:radial-gradient(ellipse at center, rgba(255,255,255,.42) 0%, transparent 68%);
  pointer-events:none;
}
/* 收藏按钮：磨砂胶囊 */
.fav-btn{
  position:absolute;top:32rpx;right:32rpx;font-size:24rpx;
  padding:10rpx 22rpx;
  background:rgba(255,255,255,.24);
  -webkit-backdrop-filter:blur(16rpx) saturate(150%);
  backdrop-filter:blur(16rpx) saturate(150%);
  border:1rpx solid rgba(255,255,255,.45);
  border-radius:16rpx;color:#fff;
}
.fav-btn.active{background:rgba(255,214,120,.42);border-color:rgba(255,232,170,.85);font-weight:600;}
.hero-route{color:rgba(255,255,255,.92);font-size:26rpx;position:relative;text-shadow:0 1rpx 8rpx rgba(30,60,110,.14);}
.hero-title{color:rgba(255,255,255,.96);font-size:30rpx;margin-top:8rpx;font-weight:600;position:relative;}
/* 会员企业名称：暖金 + 克制光晕（macOS 高光的柔和感，不做闪烁/电流） */
.hero-company.vip-name-shine{
  display:inline-block;
  font-weight:600;
  color:#ffe9a8;
  text-shadow:0 2rpx 10rpx rgba(120,80,10,.4), 0 0 24rpx rgba(255,214,120,.45);
  animation:none;
  -webkit-text-stroke:0;
}
.hero-company.vip-name-shine::before{content:none;}
.hero-company.vip-name-shine::after{content:none;}
.hero-company.vip-name-shine.vip-slow{animation:none;}
.hero-company{color:#fff;font-size:42rpx;font-weight:600;margin-top:16rpx;letter-spacing:-.5rpx;line-height:1.3;position:relative;text-shadow:0 2rpx 12rpx rgba(30,60,110,.2);}

/* 徽章 */
.detail-badges{display:flex;justify-content:flex-start;gap:12rpx;margin-top:20rpx;position:relative;}
.cert-badge{display:inline-flex;align-items:center;padding:4rpx 14rpx;border-radius:10rpx;background:rgba(255,255,255,.26);border:1rpx solid rgba(255,255,255,.45);color:#fff;font-size:20rpx;font-weight:600;}

/* 主内容（叠到渐变上） */
.main{padding:0 28rpx 60rpx;margin-top:-64rpx;position:relative;z-index:2;}

/* ===== 核心信息卡（磨砂玻璃） ===== */
.stats-card{
  display:flex;align-items:stretch;padding:32rpx 10rpx;
  border-radius:24rpx;
  background:rgba(255,255,255,.9);
  -webkit-backdrop-filter:blur(16rpx) saturate(150%);
  backdrop-filter:blur(16rpx) saturate(150%);
  border:1rpx solid rgba(255,255,255,.96);
  box-shadow:0 4rpx 12rpx rgba(20,40,70,.06), 0 18rpx 44rpx rgba(20,40,70,.1);
}
.stat{flex:1;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 8rpx;}
.stat.stat-price{flex:1.4;}
.stat-v{font-size:28rpx;font-weight:600;color:var(--ink-title);line-height:1.35;}
.stat-v.stat-price-v{font-size:24rpx;}
.stat-v.highlight{color:#3f8a6a;}
.stat-l{font-size:22rpx;color:var(--ink-muted);margin-top:10rpx;}
.stat-divider{width:1rpx;background:rgba(120,140,170,.2);align-self:stretch;margin:6rpx 0;}

/* ===== 区块卡（磨砂玻璃） ===== */
.section-card{
  margin-top:20rpx;border-radius:24rpx;padding:28rpx;
  background:rgba(255,255,255,.88);
  -webkit-backdrop-filter:blur(16rpx) saturate(150%);
  backdrop-filter:blur(16rpx) saturate(150%);
  border:1rpx solid rgba(255,255,255,.96);
  box-shadow:var(--shadow-card);
}
/* 地址与联系：点击时磨砂加深 */
.contact-card{margin-top:20rpx;}
.contact-card.card-pressed{background:rgba(255,255,255,.96);}
/* 小标题：macOS 圆点装饰 */
.card-title{
  font-size:28rpx;font-weight:600;color:var(--ink-title);margin-bottom:16rpx;
  display:flex;align-items:center;gap:12rpx;
}
.card-title::before{
  content:'';width:8rpx;height:24rpx;border-radius:4rpx;
  background:linear-gradient(180deg,#3f96ea,#2383e2);flex-shrink:0;
}

/* 标签 */
.tags-list{display:flex;flex-wrap:wrap;gap:12rpx;}
.tag-item{background:var(--bg-inset);color:var(--ink-muted);font-size:24rpx;padding:8rpx 20rpx;border-radius:12rpx;}

/* 联系区 */
.contact-item{display:flex;align-items:center;padding:22rpx 0;border-bottom:1rpx solid rgba(120,140,170,.14);}
.contact-item:last-child{border-bottom:none;}
/* 图标底：磨砂淡蓝圆角 */
.c-icon{
  width:64rpx;height:64rpx;border-radius:18rpx;
  background:rgba(35,131,226,.1);
  border:1rpx solid rgba(255,255,255,.85);
  display:flex;align-items:center;justify-content:center;
  font-size:30rpx;margin-right:16rpx;
}
.contact-info{flex:1;margin-right:12rpx;}
.contact-label{display:block;font-size:22rpx;color:var(--ink-muted);margin-bottom:6rpx;}
.phone-line{margin-top:4rpx;}
.phone-line:first-of-type{margin-top:0;}
.action-icon{font-size:22rpx;color:var(--brand);padding:8rpx 18rpx;background:rgba(35,131,226,.1);border-radius:12rpx;}

/* ===== 底部操作栏（磨砂玻璃浮层） ===== */
.bottom-bar{
  position:fixed;bottom:0;left:0;right:0;
  display:flex;gap:16rpx;
  padding:16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background:rgba(255,255,255,.9);
  -webkit-backdrop-filter:blur(16rpx) saturate(150%);
  backdrop-filter:blur(16rpx) saturate(150%);
  border-top:1rpx solid rgba(255,255,255,.9);
  box-shadow:0 -6rpx 24rpx rgba(20,40,70,.08);
}
.bar-btn{flex:1;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;font-size:28rpx;font-weight:600;white-space:nowrap;}
.bar-btn::after{border:none;}
.btn-share{background:rgba(255,255,255,.92);color:var(--ink-body);border:1rpx solid rgba(120,140,170,.22);}
.btn-call{background:linear-gradient(135deg,#3f96ea,#2383e2);color:#fff;box-shadow:0 8rpx 20rpx rgba(35,131,226,.3);}
.btn-primary-cta{flex:1.6;}

/* 空状态 */
.empty-card{text-align:center;padding:60rpx 24rpx;border-radius:24rpx;}
/* 底部导航按钮 */
.btn-nav{background:rgba(255,255,255,.92);color:var(--ink-body);border:1rpx solid rgba(120,140,170,.22);}
/* 后台选点按钮 */
.loc-btn{flex:1;font-size:26rpx;color:var(--brand);background:rgba(35,131,226,.1);padding:14rpx 16rpx;border-radius:14rpx;text-align:center;}

/* ===== 错误态 ===== */
.error-emoji { font-size:80rpx; margin-bottom:16rpx; }
.error-text { color:var(--ink-muted); font-size:28rpx; margin-bottom:32rpx; }
.error-actions { display:flex; gap:24rpx; }
.error-btn {
  padding:16rpx 48rpx;
  border-radius:16rpx;
  background:linear-gradient(135deg,#3f96ea,#2383e2);
  color:#fff;
  font-size:28rpx;
}
.error-btn.ghost {
  background:rgba(255,255,255,.92);
  color:var(--ink-body);
  border:1rpx solid rgba(120,140,170,.22);
}

/* ===== 发站/到站分组（圆点 + 色彩区分） ===== */
.station-block { margin-bottom:8rpx; }
.station-head {
  font-size:26rpx; font-weight:600; margin:20rpx 0 4rpx;
  padding:0; border:none; color:var(--brand-deep);
  display:flex; align-items:center; justify-content:space-between;
}
.station-head.to-head { color:var(--sky-green-ink); }
.station-act {
  font-size:22rpx; font-weight:400; color:var(--brand);
  padding:6rpx 14rpx;
  background:rgba(255,255,255,.8);
  border:1rpx solid rgba(120,140,170,.2);
  border-radius:12rpx;
}
.station-head.to-head .station-act { color:var(--sky-green-ink); }

/* ===== 网点条目 ===== */
.pair-item {
  display:flex; align-items:center; gap:16rpx;
  padding:18rpx 0; border-bottom:1rpx solid rgba(120,140,170,.14);
}
.pair-item:last-of-type { border-bottom:none; }
.pair-main { flex:1; min-width:0; }
.pair-addr { display:flex; align-items:flex-start; }
.pair-addr-text {
  flex:1; min-width:0; font-size:26rpx;
  color:var(--ink-body); word-break:break-all; line-height:36rpx;
}
.pair-km {
  flex-shrink:0; font-size:22rpx; font-weight:600;
  color:var(--brand); margin-left:8rpx; line-height:36rpx;
}
.pair-icon { font-size:24rpx; margin-right:8rpx; flex-shrink:0; line-height:36rpx; }
.pair-phones {
  display:flex; flex-wrap:wrap;
  column-gap:20rpx; row-gap:6rpx;
  margin-top:8rpx;
}
.phone-chip { font-size:26rpx; color:var(--ink-body); }
/* 右侧拨号按钮：磨砂圆形蓝底 */
.pair-call {
  flex-shrink:0; width:72rpx; height:72rpx; line-height:72rpx;
  text-align:center; font-size:32rpx;
  background:rgba(35,131,226,.12);
  border:1rpx solid rgba(255,255,255,.85);
  border-radius:20rpx;
}
.pair-empty { font-size:26rpx; color:var(--ink-muted); padding:12rpx 0; }
