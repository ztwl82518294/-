/* 协议页样式（磨砂长文卡片：宽行距 + 可长时间阅读） */
.doc {
  padding: 44rpx 40rpx 80rpx;
  margin: 24rpx 24rpx 40rpx;
  background: rgba(255,255,255,.91);
  -webkit-backdrop-filter: blur(16rpx) saturate(150%);
  backdrop-filter: blur(16rpx) saturate(150%);
  border: 1rpx solid rgba(255,255,255,.96);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}
.doc-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink-title);
  text-align: center;
  letter-spacing: -.4rpx;
}
.doc-updated {
  font-size: 24rpx;
  color: var(--ink-muted);
  text-align: center;
  margin: 14rpx 0 44rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid rgba(120, 140, 170, .16);
}
/* 章节标题：左侧色条点缀 */
.doc-h {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink-title);
  margin: 40rpx 0 14rpx;
  line-height: 1.4;
}
.doc-p {
  font-size: 28rpx;
  color: var(--ink-body);
  line-height: 1.85;
  margin-bottom: 14rpx;
  text-align: justify;
}
